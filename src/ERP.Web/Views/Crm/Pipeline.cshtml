@model List<Opportunity>
@{
    ViewData["Title"] = "Cơ hội bán hàng"; var can = (bool)ViewBag.CanEdit;
    var cols = new[] { OppStage.Prospecting, OppStage.Qualified, OppStage.Proposal, OppStage.Negotiation, OppStage.Won, OppStage.Lost };
}
<partial name="_CrmNav" model="@("pipe")" />
<div class="toolbar">
    <form method="get" class="d-inline-flex gap-1"><select name="ownerId" asp-items="ViewBag.Owners" class="form-select form-select-sm"><option value="">Mọi người phụ trách</option></select><button class="btn btn-sm btn-light border">Lọc</button></form>
    <span class="small text-muted ms-2">Đang mở: @Model.Count(o => o.IsOpen) cơ hội · @Model.Where(o => o.IsOpen).Sum(o => o.Amount).ToMoney() đ · có trọng số @Model.Where(o => o.IsOpen).Sum(o => o.Weighted).ToMoney() đ</span>
    @if (can) { <a class="btn btn-sm btn-primary ms-auto" asp-action="OppForm">+ Thêm cơ hội</a> }
</div>
<div class="d-flex gap-2" style="overflow-x:auto">
@foreach (var s in cols)
{
    var items = Model.Where(o => o.Stage == s).ToList();
    <div style="min-width:230px;flex:1">
        <div class="card"><div class="card-header py-1 small fw-bold d-flex justify-content-between"><span>@s.GetDisplayName() (@items.Count)</span><span>@items.Sum(o => o.Amount).ToMoney()</span></div>
        <div class="card-body p-1" style="min-height:120px">
        @foreach (var o in items)
        {
            <div class="border rounded p-2 mb-1 small bg-white">
                <a asp-action="OppDetails" asp-route-id="@o.Id" class="fw-semibold">@o.Title</a>
                <div class="text-muted">@(o.Partner?.Name ?? o.Lead?.Name)</div>
                <div class="d-flex justify-content-between"><b>@o.Amount.ToMoney()</b><span>@o.Probability%</span></div>
                <div class="text-muted">@o.ExpectedClose.ToString("dd/MM/yyyy") · @o.Owner?.FullName</div>
                @if (can && o.IsOpen)
                {
                    <form asp-action="MoveOpp" method="post" class="d-flex gap-1 mt-1"><input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="fromBoard" value="true" />
                        <select name="stage" class="form-select form-select-sm py-0" onchange="if(this.value==='@((int)OppStage.Lost)'){var r=prompt('Lý do thua?');if(!r){this.value='@((int)o.Stage)';return;}this.form.reason.value=r;} this.form.submit()">
                            @foreach (var t in cols) { <option value="@((int)t)" selected="@(t == o.Stage)">@t.GetDisplayName()</option> }
                        </select><input type="hidden" name="reason" /></form>
                }
            </div>
        }
        </div></div>
    </div>
}
</div>
