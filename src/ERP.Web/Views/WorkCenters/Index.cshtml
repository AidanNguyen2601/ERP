@model List<WorkCenter>
@{
    ViewData["Title"] = "Trung tâm sản xuất"; var e = (WorkCenter)ViewBag.Edit; var can = (bool)ViewBag.CanEdit;
    var used = (Dictionary<int, int>)ViewBag.Used; var hrs = (Dictionary<int, (decimal Hours, decimal Qty)>)ViewBag.Hours;
}
<partial name="_MfgNav" model="@("wc")" />
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
        <thead><tr><th>Mã</th><th>Tên</th><th>Bộ phận</th><th class="num">Giờ / ngày</th><th class="num">Hiệu suất</th><th class="num">Công suất / tháng (giờ)</th><th class="num">Nhân công / giờ</th><th class="num">SXC / giờ</th><th class="num">NS chuẩn (SP/giờ)</th><th class="num">Công đoạn</th><th class="num">30 ngày qua</th><th></th></tr></thead>
        <tbody>
        @foreach (var w in Model)
        {
            var h = hrs.TryGetValue(w.Id, out var x) ? x : (Hours: 0m, Qty: 0m);
            <tr class="@(w.IsActive ? "" : "text-muted")"><td>@w.Code</td><td>@w.Name</td><td>@w.Department</td><td class="num">@w.HoursPerDay.ToQty()</td><td class="num">@w.Efficiency.ToQty()%</td>
                <td class="num">@((w.HoursPerDay * w.Efficiency / 100 * MpsService.WorkDaysPerMonth).ToQty())</td><td class="num">@w.LaborRatePerHour.ToMoney()</td><td class="num">@w.OverheadRatePerHour.ToMoney()</td>
                <td class="num">@(w.UnitsPerHour > 0 ? w.UnitsPerHour.ToQty() : "")</td><td class="num">@used.GetValueOrDefault(w.Id)</td>
                <td class="num">@(h.Hours > 0 ? $"{h.Hours.ToQty()} giờ · {h.Qty.ToQty()} SP" : "")</td>
                <td>@if (can) { <a class="small" asp-action="Index" asp-route-edit="@w.Id">Sửa</a> }</td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="12" class="text-center text-muted py-4">Chưa khai báo trung tâm sản xuất.</td></tr> }
        </tbody></table></div></div></div></div>
    @if (can)
    {
        <div class="col-lg-4"><div class="card"><div class="card-header">@(e.Id == 0 ? "Thêm trung tâm sản xuất" : $"Sửa {e.Code}")</div><div class="card-body">
            <form asp-action="Save" method="post" class="row g-2">
                <input type="hidden" name="Id" value="@e.Id" />
                <div class="col-4"><label class="form-label small">Mã</label><input name="Code" value="@e.Code" class="form-control form-control-sm" /></div>
                <div class="col-8"><label class="form-label small">Tên trung tâm / chuyền</label><input name="Name" value="@e.Name" class="form-control form-control-sm" /></div>
                <div class="col-12"><label class="form-label small">Bộ phận</label><input name="Department" value="@e.Department" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Giờ / ngày</label><input name="HoursPerDay" type="number" step="0.5" value="@e.HoursPerDay.Raw()" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Hiệu suất %</label><input name="Efficiency" type="number" step="1" value="@e.Efficiency.Raw()" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Công nhân / ca</label><input name="Workers" type="number" min="1" value="@e.Workers" class="form-control form-control-sm" /></div>
                <div class="col-6"><label class="form-label small">Nhân công / giờ</label><input name="LaborRatePerHour" type="number" step="1000" value="@e.LaborRatePerHour.Raw()" class="form-control form-control-sm" /></div>
                <div class="col-6"><label class="form-label small">SXC / giờ</label><input name="OverheadRatePerHour" type="number" step="1000" value="@e.OverheadRatePerHour.Raw()" class="form-control form-control-sm" /></div>
                <div class="col-6"><label class="form-label small">Năng suất chuẩn (SP / giờ)</label><input name="UnitsPerHour" type="number" step="0.1" value="@e.UnitsPerHour.Raw()" class="form-control form-control-sm" /></div>
                <div class="col-6 pt-4"><div class="form-check"><input type="checkbox" class="form-check-input" name="IsActive" value="true" @(e.IsActive ? "checked" : "") /><input type="hidden" name="IsActive" value="false" /><label class="form-check-label small">Đang sử dụng</label></div></div>
                <div class="col-12"><button class="btn btn-sm btn-primary">Lưu</button> @if (e.Id != 0) { <a class="btn btn-sm btn-light" asp-action="Index">Hủy</a> }</div>
            </form>
            <div class="small text-muted mt-3">Công suất tháng = giờ / ngày × hiệu suất × 22 ngày. Đơn giá giờ dùng để tính nhân công, SXC định mức theo quy trình; năng suất chuẩn dùng so sánh với năng suất thực tế trong Thống kê sản lượng.</div>
        </div></div></div>
    }
</div>
