@model QcPlan
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm kế hoạch kiểm tra" : $"Sửa kế hoạch {Model.Code}"; }
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 empty-hide"></div>
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-md-2"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="Html.GetEnumSelectList<QcStage>()" class="form-select"></select></div>
        <div class="col-md-5"><label asp-for="ItemId" class="form-label"></label><select asp-for="ItemId" asp-items="ViewBag.Items" class="form-select"><option value="">-- Không chọn (theo loại hàng / chung) --</option></select></div>
        <div class="col-md-3"><label asp-for="ItemType" class="form-label"></label><select asp-for="ItemType" asp-items="Html.GetEnumSelectList<ItemType>()" class="form-select"><option value="">-- Mọi loại --</option></select></div>
        <div class="col-md-2"><label asp-for="SamplePct" class="form-label"></label><input asp-for="SamplePct" type="number" step="0.1" min="0" max="100" class="form-control" /></div>
        <div class="col-md-2 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        <div class="col-md-4"><label asp-for="SamplingMethod" class="form-label"></label><select asp-for="SamplingMethod" asp-items="Html.GetEnumSelectList<QcSamplingMethod>()" class="form-select"></select></div>
        <div class="col-md-2"><label asp-for="AqlValue" class="form-label"></label><select asp-for="AqlValue" class="form-select"><option value="">--</option>@foreach (var a in ERP.Web.Services.QualityService.AqlOptions) { <option value="@a.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(Model.AqlValue == a)">@a.ToString("0.##")</option> }</select><span asp-validation-for="AqlValue" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="FixedSampleQty" class="form-label"></label><input asp-for="FixedSampleQty" type="number" step="1" min="0" class="form-control" /><span asp-validation-for="FixedSampleQty" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="MaxDefectPct" class="form-label"></label><input asp-for="MaxDefectPct" type="number" step="0.1" min="0" max="100" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="OperationName" class="form-label"></label><input asp-for="OperationName" class="form-control" placeholder="Chỉ cho kiểm tra trong quá trình – VD: Sơn PU" /></div>
        <div class="col-12 small text-muted">Lấy mẫu theo AQL: cỡ mẫu và số lỗi chấp nhận / loại tự tính theo cỡ lô (bảng rút gọn ISO 2859-1, mức II, kiểm tra bình thường). Ngưỡng đạt: lô có tỷ lệ lỗi trong mẫu vượt ngưỡng thì phải kết luận Không đạt. Tỷ lệ % và số lượng cố định chỉ dùng khi chọn cách lấy mẫu tương ứng.</div>
        <div class="col-12"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" /></div>
    </div></div></div>

    <div class="card mb-3"><div class="card-header">Tiêu chí kiểm tra</div><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-sm mb-0 line-editor">
            <thead><tr><th style="width:36px">#</th><th style="min-width:220px">Tiêu chí</th><th style="min-width:150px">Phương pháp</th><th style="width:150px">Kiểu</th>
                <th style="width:90px">Min</th><th style="width:90px">Max</th><th style="width:70px">ĐVT</th><th style="min-width:150px">Tiêu chuẩn (mô tả)</th><th style="width:110px">Trọng yếu</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in Model.Lines.DefaultIfEmpty(new QcPlanLine()))
            {
                <tr class="line">
                    <td class="idx text-muted"></td>
                    <td><input class="form-control form-control-sm" data-f="Name" value="@l.Name" placeholder="VD: Độ dày tấm ván" /></td>
                    <td><input class="form-control form-control-sm" data-f="Method" value="@l.Method" /></td>
                    <td><select class="form-select form-select-sm" data-f="Type">
                        <option value="PassFail" selected="@(l.Type == QcCriterionType.PassFail)">Đạt / Không đạt</option>
                        <option value="Measure" selected="@(l.Type == QcCriterionType.Measure)">Đo lường</option></select></td>
                    <td><input class="form-control form-control-sm text-end" inputmode="decimal" data-f="MinValue" value="@l.MinValue?.Raw()" /></td>
                    <td><input class="form-control form-control-sm text-end" inputmode="decimal" data-f="MaxValue" value="@l.MaxValue?.Raw()" /></td>
                    <td><input class="form-control form-control-sm" data-f="Unit" value="@l.Unit" /></td>
                    <td><input class="form-control form-control-sm" data-f="Standard" value="@l.Standard" placeholder="Tự sinh nếu để trống" /></td>
                    <td><select class="form-select form-select-sm" data-f="IsCritical">
                        <option value="false" selected="@(!l.IsCritical)">Không</option><option value="true" selected="@l.IsCritical">Trọng yếu</option></select></td>
                    <td><button type="button" class="btn btn-sm btn-light remove-line" title="Xóa dòng">✕</button></td>
                </tr>
            }
            </tbody>
            <tfoot><tr><td colspan="10"><button type="button" class="btn btn-sm btn-outline-primary" data-add-line><i class="bi bi-plus-lg"></i> Thêm tiêu chí</button>
                <span class="small text-muted ms-2">Tiêu chí đo lường: nhập giới hạn dưới / trên, kết quả đo nằm trong khoảng là đạt.</span></td></tr></tfoot>
        </table>
    </div></div></div>
    <button class="btn btn-primary"><i class="bi bi-check2"></i> Lưu kế hoạch</button>
    <a class="btn btn-light" asp-action="@(Model.Id == 0 ? "Index" : "Details")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)">Hủy</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
