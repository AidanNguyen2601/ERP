@model List<AppUser>
@{ ViewData["Title"] = "Người dùng & phân quyền"; }
<div class="toolbar"><a class="btn btn-primary" asp-action="Create">+ Thêm người dùng</a></div>
<div class="card"><div class="card-body p-0"><table class="table table-hover mb-0">
    <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Phòng ban</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Đăng nhập gần nhất</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr><td><b>@u.Username</b></td><td>@u.FullName</td><td>@u.Department</td><td>@u.Email</td>
            <td><span class="badge bg-primary">@AppRoles.DisplayName(u.Role)</span></td>
            <td>@(u.IsActive ? Html.Raw("<span class='badge bg-success'>Hoạt động</span>") : Html.Raw("<span class='badge bg-secondary'>Đã khóa</span>"))</td>
            <td>@u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">Sửa</a></td></tr>
    }
    </tbody>
</table></div></div>
<div class="card mt-3"><div class="card-body small">
    <b>Phân quyền:</b>
    <ul class="mb-0">
        <li><b>Ban Giám đốc</b>: xem toàn bộ, duyệt đơn mua vượt ngưỡng, duyệt bán vượt hạn mức công nợ.</li>
        <li><b>Kế toán</b>: kế toán tổng hợp, phải thu, phải trả, tiền, hóa đơn, tài sản cố định, khóa sổ.</li>
        <li><b>Kinh doanh</b>: khách hàng, đơn bán hàng.</li>
        <li><b>Mua hàng</b>: nhà cung cấp, đơn mua hàng.</li>
        <li><b>Thủ kho</b>: phiếu nhập / xuất / chuyển kho, kiểm kê, nhận hàng mua, giao hàng bán.</li>
        <li><b>Sản xuất</b>: định mức (BOM), lệnh sản xuất, hoạch định nhu cầu vật tư.</li>
        <li><b>Quản trị hệ thống</b>: toàn quyền, quản lý người dùng.</li>
    </ul>
</div></div>
