@inject Microsoft.Extensions.Options.IOptions<ErpSettings> Cfg
@inject PreferenceService Prefs
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject ERP.Web.Data.ErpDbContext LayoutDb
@inject WorkflowService LayoutWf
@{
    var ctx = Menu.Context(ViewContext);
    var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var ui = await Prefs.GetUiAsync();
    var favorites = await Prefs.GetFavoritesAsync();
    var grids = await Prefs.GetGridsAsync();
    var activeItem = Menu.FindActive(ctx);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var title = Lang.T(Context, ViewData["Title"]?.ToString() ?? "");
    var allowedBranches = BranchScope.Allowed(User);
    var branchList = new List<Branch>(); var pendingCount = 0;
    try
    {
        branchList = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(LayoutDb.Branches.Where(b => b.IsActive && (allowedBranches == null || allowedBranches.Contains(b.Id))).OrderBy(b => b.Code));
        pendingCount = (await LayoutWf.InboxAsync(User)).Count;
    }
    catch { }
    var selBranch = BranchScope.Selected(Context);
    var isEn = Lang.IsEn(Context);
    var bodyClass = $"menu-{ui.MenuPosition} sidebar-{ui.SidebarStyle}" + (ui.MenuCollapsed && ui.IsVertical ? " menu-collapsed" : "") + (ui.CompactTables ? " grid-compact" : "");
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var clientState = new
    {
        favorites,
        grids,
        collapsed = ui.MenuCollapsed,
        urls = new
        {
            toggleFavorite = Url.Action("ToggleFavorite", "Preferences"),
            saveFavorites = Url.Action("SaveFavorites", "Preferences"),
            saveGrid = Url.Action("SaveGrid", "Preferences"),
            collapse = Url.Action("Collapse", "Preferences"),
        }
    };
}
<!DOCTYPE html>
<html lang="@(isEn ? "en" : "vi")" style="--accent:@ui.PrimaryColor;--accent-dark:@ui.PrimaryDark;--accent-soft:@ui.PrimarySoft;--app-font:@ui.FontCss;font-size:@(ui.FontSize)px">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@token" />
    <title>@title - ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
<div class="app">
    @if (ui.IsVertical)
    {
        <aside class="sidebar" id="sidebar">
            <div class="brand-row">
                <a class="brand" asp-controller="Home" asp-action="Index" title="ERP Suite"><i class="bi bi-grid-3x3-gap-fill brand-ico"></i><span class="txt">ERP<span>Suite</span></span></a>
                <button type="button" class="icon-btn collapse-btn" data-menu-collapse title="Thu gọn / mở rộng menu"><i class="bi bi-chevron-double-left"></i></button>
            </div>
            <div class="nav-tools">
                <div class="nav-search"><i class="bi bi-search"></i><input type="search" placeholder="Tìm chức năng..." data-menu-search aria-label="Tìm chức năng" /></div>
                <button type="button" class="icon-btn" data-menu-expand-all title="Mở rộng / thu gọn tất cả nhóm"><i class="bi bi-arrows-collapse"></i></button>
            </div>
            <partial name="_Menu" model="@("vertical")" />
        </aside>
        <div class="sidebar-backdrop" data-menu-close></div>
    }
    <div class="main">
        @if (ui.MenuPosition == "top") { <partial name="_Menu" model="@("top")" /> }
        <header class="topbar">
            <div class="d-flex align-items-center gap-2 min-w-0">
                @if (ui.IsVertical) { <button type="button" class="icon-btn mobile-menu-btn" data-menu-open title="Menu"><i class="bi bi-list"></i></button> }
                <div class="min-w-0">
                    <div class="company">@Cfg.Value.CompanyName</div>
                    <h1 class="page-title">
                        @if (activeItem != null) { <i class="bi @activeItem.Icon page-ico"></i> }
                        <span>@title</span>
                        <button type="button" class="fav-star" data-fav-url="@currentUrl" data-fav-title="@title" data-fav-icon="@(activeItem?.Icon ?? "bi-star")" title="Thêm / bỏ trang này khỏi yêu thích">
                            <i class="bi bi-star"></i>
                        </button>
                    </h1>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (branchList.Count > 1)
                {
                    <form asp-controller="Org" asp-action="Switch" method="post" class="d-none d-md-block" title="@Lang.T(Context, "Chi nhánh")">
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <select name="branchId" class="form-select form-select-sm" style="max-width:190px" onchange="this.form.submit()">
                            @if (allowedBranches == null || allowedBranches.Length > 1) { <option value="0">@Lang.T(Context, "Tất cả chi nhánh")</option> }
                            @foreach (var b in branchList) { <option value="@b.Id" selected="@(selBranch == b.Id)">@b.Code – @b.Name</option> }
                        </select>
                    </form>
                }
                <a class="icon-btn position-relative" asp-controller="Approvals" asp-action="Index" title="@Lang.T(Context, "Chờ duyệt")"><i class="bi bi-check2-circle"></i>
                    @if (pendingCount > 0) { <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.6rem">@pendingCount</span> }</a>
                <form asp-controller="Org" asp-action="Language" method="post" class="d-inline"><input type="hidden" name="returnUrl" value="@currentUrl" /><input type="hidden" name="lang" value="@(isEn ? "vi" : "en")" />
                    <button class="icon-btn" title="@(isEn ? "Tiếng Việt" : "English")" style="font-size:.75rem;font-weight:600">@(isEn ? "VI" : "EN")</button></form>
                <a class="icon-btn" asp-controller="Preferences" asp-action="Index" title="Cấu hình giao diện"><i class="bi bi-palette"></i></a>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="avatar">@(User.GetFullName().Length > 0 ? char.ToUpper(User.GetFullName().Split(' ').Last()[0]) : '?')</span>
                        <span class="d-none d-md-inline">@User.GetFullName() <small class="text-muted">(@AppRoles.DisplayName(role))</small></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Preferences" asp-action="Index"><i class="bi bi-palette me-2"></i>@Lang.T(Context, "Cấu hình giao diện")</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>@Lang.T(Context, "Đổi mật khẩu")</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>@Lang.T(Context, "Đăng xuất")</button></form></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="content">
            @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Warning"] is string wr) { <div class="alert alert-warning alert-dismissible fade show">@wr<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </main>
        <footer class="footer">&copy; @DateTime.Now.Year ERP — ASP.NET Core 8 MVC + SQL Server</footer>
        @if (ui.MenuPosition == "bottom") { <partial name="_Menu" model="@("bottom")" /> }
    </div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toasts"></div>
<script>window.ERP = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clientState, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/ui.js" asp-append-version="true"></script>
<script src="~/js/grid.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
