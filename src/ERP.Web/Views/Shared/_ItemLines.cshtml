@model LineEditorOptions
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var lines = Model.Lines.Any() ? Model.Lines : new List<LineInput> { new() { Quantity = 1 } };
    string P(Item i) => (Model.PriceSource == "cost" ? i.AvgCost : i.SalePrice).ToString("0.##", inv);
}
<div class="table-responsive">
<table class="table table-sm align-middle line-editor" data-calc="@(Model.ShowPrice ? "1" : "0")">
    <thead><tr>
        <th style="width:36px">#</th>
        <th style="min-width:260px">Hàng hóa / vật tư</th>
        @if (Model.AllowFreeText) { <th style="min-width:180px">Diễn giải</th> }
        @if (Model.ShowCounted) { <th class="text-end" style="width:120px">Thực tế kiểm</th> } else { <th class="text-end" style="width:110px">@Model.QtyLabel</th> }
        @if (Model.ShowScrap) { <th class="text-end" style="width:100px">Hao hụt %</th> }
        @if (Model.ShowPrice) { <th class="text-end" style="width:140px">@Model.PriceLabel</th> }
        @if (Model.ShowDiscount) { <th class="text-end" style="width:90px">CK %</th> }
        @if (Model.ShowVat) { <th class="text-end" style="width:90px">VAT %</th> }
        @if (Model.ShowAccount) { <th style="width:200px">TK hạch toán</th> }
        @if (Model.ShowPrice) { <th class="text-end" style="width:140px">Thành tiền</th> }
        <th style="width:40px"></th>
    </tr></thead>
    <tbody>
    @foreach (var l in lines)
    {
        <tr class="line">
            <td class="idx text-muted"></td>
            <td><input type="hidden" data-f="Id" value="@l.Id" />
                <select class="form-select form-select-sm item-select" data-f="ItemId">
                    <option value="" data-price="0" data-vat="10">@(Model.AllowFreeText ? "-- Dịch vụ / chi phí khác --" : "-- Chọn --")</option>
                    @foreach (var i in Model.Items)
                    {
                        <option value="@i.Id" data-price="@P(i)" data-vat="@i.VatRate" data-unit="@i.Unit" data-name="@i.Name" selected="@(l.ItemId == i.Id)">@i.Code – @i.Name (@i.Unit)</option>
                    }
                </select></td>
            @if (Model.AllowFreeText) { <td><input class="form-control form-control-sm" data-f="Description" value="@l.Description" /></td> }
            @if (Model.ShowCounted) { <td><input type="number" step="0.001" min="0" class="form-control form-control-sm text-end" data-f="CountedQty" value="@(l.CountedQty?.Raw())" /></td> }
            else { <td><input type="number" step="0.001" min="0" class="form-control form-control-sm text-end calc" data-f="Quantity" value="@l.Quantity.Raw()" /></td> }
            @if (Model.ShowScrap) { <td><input type="number" step="0.1" min="0" max="100" class="form-control form-control-sm text-end" data-f="ScrapPct" value="@l.ScrapPct.Raw()" /></td> }
            @if (Model.ShowPrice) { <td><input type="number" step="1" min="0" class="form-control form-control-sm text-end calc price" data-f="UnitPrice" value="@l.UnitPrice.Raw()" /></td> }
            @if (Model.ShowDiscount) { <td><input type="number" step="0.1" min="0" max="100" class="form-control form-control-sm text-end calc" data-f="DiscountPct" value="@l.DiscountPct.Raw()" /></td> }
            @if (Model.ShowVat)
            {
                <td><select class="form-select form-select-sm calc vat" data-f="VatRate">
                    @foreach (var v in new[] { 0, 5, 8, 10 }) { <option value="@v" selected="@(l.VatRate == v)">@v</option> }
                </select></td>
            }
            @if (Model.ShowAccount)
            {
                <td><select class="form-select form-select-sm" data-f="AccountId"><option value="">(tự động)</option>
                    @foreach (var a in Model.Accounts) { <option value="@a.Id" selected="@(l.AccountId == a.Id)">@a.Code – @a.Name</option> }
                </select></td>
            }
            @if (Model.ShowPrice) { <td class="text-end money total"></td> }
            <td><button type="button" class="btn btn-sm btn-link text-danger remove-line" title="Xóa dòng">✕</button></td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><td colspan="20"><button type="button" class="btn btn-sm btn-outline-primary" data-add-line>+ Thêm dòng</button></td></tr>
        @if (Model.ShowPrice)
        {
            <tr class="fw-semibold"><td colspan="20" class="text-end">
                Tiền hàng: <span data-sum="sub">0</span>
                @if (Model.ShowVat) { <text> · Thuế GTGT: <span data-sum="vat">0</span> · <span class="fs-6">Tổng cộng: <span data-sum="total">0</span></span></text> }
            </td></tr>
        }
    </tfoot>
</table>
</div>
