@model string
@{
    (string Key, string Title, string Ctl, string Act)[] tabs =
    {
        ("mo", "Lệnh sản xuất", "Production", "Index"), ("bom", "Định mức (BOM)", "Boms", "Index"), ("wc", "Trung tâm sản xuất", "WorkCenters", "Index"),
        ("mps", "Kế hoạch tổng thể (MPS)", "Mps", "Index"), ("mrp", "Hoạch định vật tư", "Production", "Mrp"), ("out", "Thống kê sản lượng", "Production", "Outputs"),
        ("var", "Định mức vs thực tế", "Production", "Variance"), ("os", "Gia công ngoài", "Outsource", "Index")
    };
}
<div class="subnav">@foreach (var t in tabs) { <a class="@(Model == t.Key ? "active" : "")" asp-controller="@t.Ctl" asp-action="@t.Act">@t.Title</a> }</div>
