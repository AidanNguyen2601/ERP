@model string
@*
    Menu chính, dựng từ Infrastructure/Menu.cs.
    Model: "vertical" (sidebar trái / phải) | "top" | "bottom" (thanh ngang).
    Nhóm "Yêu thích" do ui.js dựng từ window.ERP.favorites vào [data-fav-list].
*@
@{
    var ctx = Menu.Context(ViewContext);
    var groups = Menu.VisibleGroups(User).ToList();
    var homeUrl = Menu.Home.Url(Url);
}
@if (Model == "vertical")
{
    <nav class="side-nav" data-side-nav>
        <div class="nav-sec fav-sec open" data-group="fav" hidden>
            <button type="button" class="nav-group" data-group-toggle title="Yêu thích"><i class="bi bi-star-fill gico fav-color"></i><span class="txt">Yêu thích</span><i class="bi bi-chevron-down caret"></i></button>
            <div class="nav-items" data-fav-list data-fav-mode="side"></div>
        </div>
        <a class="nav-item @(Menu.Home.Active(ctx) ? "active" : "")" href="@homeUrl" title="@Menu.Home.Title"><i class="bi @Menu.Home.Icon"></i><span class="txt">@Menu.Home.Title</span></a>
        @foreach (var (g, items) in groups)
        {
            var groupActive = items.Any(i => i.Active(ctx));
            <div class="nav-sec open @(groupActive ? "has-active" : "")" data-group="@g.Key">
                <button type="button" class="nav-group" data-group-toggle title="@g.Title"><i class="bi @g.Icon gico"></i><span class="txt">@g.Title</span><i class="bi bi-chevron-down caret"></i></button>
                <div class="nav-items">
                    <div class="flyout-title">@g.Title</div>
                    @foreach (var i in items)
                    {
                        var url = i.Url(Url);
                        <a class="nav-item @(i.Active(ctx) ? "active" : "")" href="@url" title="@i.Title" data-search="@i.Title @g.Title">
                            <i class="bi @i.Icon"></i><span class="txt">@i.Title</span>
                            <span class="fav-toggle" role="button" tabindex="0" data-fav-url="@url" data-fav-title="@i.Title" data-fav-icon="@i.Icon" title="Thêm / bỏ yêu thích"><i class="bi bi-star"></i></span>
                        </a>
                    }
                </div>
            </div>
        }
    </nav>
}
else
{
    var up = Model == "bottom";
    var popper = "{\"strategy\":\"fixed\"}";
    <nav class="hnav hnav-@Model">
        <a class="hbrand" href="@homeUrl"><i class="bi bi-grid-3x3-gap-fill"></i> ERP<span>Suite</span></a>
        <div class="hnav-scroll">
            <a class="hlink @(Menu.Home.Active(ctx) ? "active" : "")" href="@homeUrl"><i class="bi @Menu.Home.Icon"></i><span>@Menu.Home.Title</span></a>
            <div class="@(up ? "dropup" : "dropdown") fav-sec" hidden>
                <button type="button" class="hlink dropdown-toggle" data-bs-toggle="dropdown" data-bs-popper-config="@popper"><i class="bi bi-star-fill fav-color"></i><span>Yêu thích</span></button>
                <div class="dropdown-menu shadow" data-fav-list data-fav-mode="dropdown"></div>
            </div>
            @foreach (var (g, items) in groups)
            {
                <div class="@(up ? "dropup" : "dropdown")">
                    <button type="button" class="hlink dropdown-toggle @(items.Any(i => i.Active(ctx)) ? "active" : "")" data-bs-toggle="dropdown" data-bs-popper-config="@popper">
                        <i class="bi @g.Icon"></i><span>@g.Title</span></button>
                    <div class="dropdown-menu shadow">
                        @foreach (var i in items)
                        {
                            var url = i.Url(Url);
                            <a class="dropdown-item d-flex align-items-center gap-2 @(i.Active(ctx) ? "active" : "")" href="@url">
                                <i class="bi @i.Icon"></i><span class="flex-grow-1">@i.Title</span>
                                <span class="fav-toggle" role="button" tabindex="0" data-fav-url="@url" data-fav-title="@i.Title" data-fav-icon="@i.Icon" title="Thêm / bỏ yêu thích"><i class="bi bi-star"></i></span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </nav>
}
