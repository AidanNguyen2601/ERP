@model Bom
@{
    ViewData["Title"] = $"Định mức {Model.Code}";
    var orders = (List<ProductionOrder>)ViewBag.Orders;
    decimal Need(BomLine l) => l.Quantity * (100 + l.ScrapPct) / 100 / Model.OutputQuantity;
    var mat = Model.Lines.Sum(l => Need(l) * (l.Item?.AvgCost ?? 0));
}
<div class="subnav"><a asp-action="Index">← Danh sách định mức</a>
    @if ((bool)ViewBag.CanEdit) { <a asp-action="Edit" asp-route-id="@Model.Id">Sửa</a><a asp-controller="Production" asp-action="Create" asp-route-bomId="@Model.Id">+ Lập lệnh sản xuất</a> }</div>
<div class="card mb-3"><div class="card-body">
    <div class="fs-5 fw-semibold">@Model.FinishedItem?.Code – @Model.FinishedItem?.Name</div>
    <div class="meta mb-2">Sản lượng định mức @Model.OutputQuantity.ToQty() @Model.FinishedItem?.Unit · @Model.Note</div>
    <table class="table table-sm">
        <thead><tr><th>Nguyên vật liệu</th><th class="num">Định mức</th><th class="num">Hao hụt</th><th class="num">Nhu cầu / 1 SP</th><th class="num">Giá vốn BQ</th><th class="num">Chi phí / 1 SP</th></tr></thead>
        <tbody>@foreach (var l in Model.Lines) { <tr><td>@l.Item?.Code – @l.Item?.Name</td><td class="num">@l.Quantity.ToQty() @l.Item?.Unit</td><td class="num">@l.ScrapPct.ToPct()</td><td class="num">@Need(l).ToQty()</td><td class="num">@l.Item?.AvgCost.ToMoney()</td><td class="num">@((Need(l) * (l.Item?.AvgCost ?? 0)).ToMoney())</td></tr> }</tbody>
        <tfoot>
            <tr><td colspan="5" class="text-end">Chi phí NVL trực tiếp</td><td class="num">@mat.ToMoney()</td></tr>
            <tr><td colspan="5" class="text-end">Nhân công trực tiếp</td><td class="num">@Model.LaborCostPerUnit.ToMoney()</td></tr>
            <tr><td colspan="5" class="text-end">Chi phí sản xuất chung</td><td class="num">@Model.OverheadPerUnit.ToMoney()</td></tr>
            <tr class="fw-bold"><td colspan="5" class="text-end">Giá thành định mức / 1 SP</td><td class="num">@((mat + Model.LaborCostPerUnit + Model.OverheadPerUnit).ToMoney())</td></tr>
        </tfoot>
    </table>
</div></div>
<div class="card"><div class="card-header">Lệnh sản xuất theo định mức này</div><div class="card-body p-0"><table class="table table-sm mb-0"><tbody>
    @foreach (var o in orders) { <tr><td><a asp-controller="Production" asp-action="Details" asp-route-id="@o.Id">@o.Number</a></td><td>@o.StartDate.ToDate()</td><td class="num">@o.Quantity.ToQty()</td><td class="num">@(o.UnitCost > 0 ? "Giá thành thực tế " + o.UnitCost.ToMoney() : "")</td><td><partial name="_Badge" model="o.Status" /></td></tr> }
</tbody></table></div></div>
