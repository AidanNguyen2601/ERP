@model List<Bom>
@{ ViewData["Title"] = "Định mức nguyên vật liệu (BOM)"; var centers = (Dictionary<int, WorkCenter>)ViewBag.Centers; var all = (bool)ViewBag.All; }
<partial name="_MfgNav" model="@("bom")" />
<div class="toolbar">
    <a class="btn btn-sm @(!all ? "btn-secondary" : "btn-light border")" asp-action="Index">Đang áp dụng</a>
    <a class="btn btn-sm @(all ? "btn-secondary" : "btn-light border")" asp-action="Index" asp-route-all="true">Tất cả phiên bản</a>
    @if ((bool)ViewBag.CanEdit) { <a class="btn btn-sm btn-primary ms-auto" asp-action="Create">+ Định mức mới</a> }
</div>
<div class="row g-3">
@foreach (var b in Model)
{
    var mat = b.Lines.Sum(l => l.Quantity * (100 + l.ScrapPct) / 100 * (l.Item?.AvgCost ?? 0)) / b.OutputQuantity;
    var cost = mat + b.LaborCostPerUnit + b.OverheadPerUnit; var price = b.FinishedItem?.SalePrice ?? 0;
    var hours = BomService.RoutingPerUnit(b, centers).Hours;
    <div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body">
        <div class="d-flex justify-content-between"><a class="fw-semibold" asp-action="Details" asp-route-id="@b.Id">@b.Code</a>
            <span><span class="badge bg-info text-dark">v@(b.VersionNo)</span> @if (!b.IsActive) { <span class="badge bg-secondary">Ngưng</span> } @if (b.FinishedItem?.Type == ItemType.SemiFinished) { <span class="badge bg-warning text-dark">Bán thành phẩm</span> }</span></div>
        <div class="mb-1">@b.FinishedItem?.Name</div>
        @if (b.EffectiveFrom != null || b.EffectiveTo != null) { <div class="small text-muted mb-1">Hiệu lực @(b.EffectiveFrom?.ToDate() ?? "…") → @(b.EffectiveTo?.ToDate() ?? "…")</div> }
        <ul class="small mb-2 ps-3">@foreach (var l in b.Lines) { <li>@l.Item?.Name@(l.Item?.Type == ItemType.SemiFinished ? " (BTP)" : ""): @l.Quantity.ToQty() @l.Item?.Unit @(l.ScrapPct > 0 ? $"(+{l.ScrapPct:0.#}% hao hụt)" : "")</li> }</ul>
        @if (b.Operations.Any()) { <div class="small text-muted mb-2">Quy trình: @string.Join(" → ", b.Operations.OrderBy(o => o.Seq).Select(o => o.Name)) · @hours.ToQty() giờ / SP</div> }
        <div class="d-flex justify-content-between small"><span class="text-muted">Giá thành định mức</span><b>@cost.ToMoney()</b></div>
        <div class="d-flex justify-content-between small"><span class="text-muted">Giá bán</span><span>@price.ToMoney()</span></div>
        <div class="d-flex justify-content-between small"><span class="text-muted">Biên lợi nhuận gộp</span><span class="@(price > 0 && (price - cost) / price < 0.2m ? "warn" : "good")">@(price > 0 ? ((price - cost) * 100 / price).ToString("0.#") + "%" : "—")</span></div>
    </div></div></div>
}
</div>
