@model List<QcNonconformance>
@{
    ViewData["Title"] = "Xử lý hàng không phù hợp (NCR)";
    var status = ViewBag.Status as NcrStatus?; var disp = ViewBag.Disposition as NcrDisposition?;
}
<form class="toolbar" method="get">
    <div><label class="form-label small mb-0">Trạng thái</label><select name="status" class="form-select form-select-sm"><option value="">-- Tất cả --</option>
        @foreach (NcrStatus s in Enum.GetValues<NcrStatus>()) { <option value="@s" selected="@(status == s)">@s.GetDisplayName()</option> }</select></div>
    <div><label class="form-label small mb-0">Hướng xử lý</label><select name="disposition" class="form-select form-select-sm"><option value="">-- Tất cả --</option>
        @foreach (NcrDisposition d in Enum.GetValues<NcrDisposition>()) { <option value="@d" selected="@(disp == d)">@d.GetDisplayName()</option> }</select></div>
    <div><label class="form-label small mb-0">Tìm</label><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" /></div>
    <div class="form-check mb-1"><input class="form-check-input" type="checkbox" name="overdue" value="true" id="od" checked="@((bool)ViewBag.Overdue)" /><label class="form-check-label small" for="od">Chỉ NCR quá hạn</label></div>
    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel"></i> Lọc</button>
    @if ((bool)ViewBag.CanManage) { <a class="btn btn-sm btn-primary ms-auto" asp-action="Create"><i class="bi bi-plus-lg"></i> Lập NCR thủ công</a> }
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
    <thead><tr><th>Số NCR</th><th>Ngày</th><th>Mặt hàng</th><th class="num">Số lượng</th><th>NCC / KH</th><th>Mô tả lỗi</th><th>Hướng xử lý</th><th>Hạn xử lý</th><th>Trạng thái</th><th>Phiếu KCS</th></tr></thead>
    <tbody>
    @foreach (var n in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@n.Id"><b>@n.Number</b></a></td><td>@n.Date.ToDate()</td>
            <td>@n.Item?.Code <div class="small text-muted">@n.Item?.Name</div></td><td class="num">@n.Quantity.ToQty()</td>
            <td class="small">@n.Partner?.Name</td>
            <td class="small" style="max-width:360px">@(n.Description.Length > 120 ? n.Description[..120] + "…" : n.Description)</td>
            <td><span class="badge @QcUi.Badge(n.Disposition)">@n.Disposition.GetDisplayName()</span></td>
            <td class="@(n.IsOverdue ? "overdue" : "")">@n.DueDate.ToDate()</td>
            <td><span class="badge @QcUi.Badge(n.Status)">@n.Status.GetDisplayName()</span></td>
            <td class="small">@if (n.Inspection != null) { <a asp-controller="QcInspections" asp-action="Details" asp-route-id="@n.InspectionId">@n.Inspection.Number</a> }</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="10" class="text-center text-muted py-3">Không có NCR.</td></tr> }
    </tbody>
</table></div></div></div>
