@model QcNonconformance
@inject AccountingService Acc
@{
    ViewData["Title"] = $"Báo cáo không phù hợp {Model.Number}";
    var canManage = (bool)ViewBag.CanManage; var canExecute = (bool)ViewBag.CanExecute;
    var needsStock = Model.Disposition is NcrDisposition.Scrap or NcrDisposition.ReturnToVendor;
    var rets = (List<PurchaseReturn>)ViewBag.Returns;
    var actions = (List<QcNcrAction>)ViewBag.Actions; var reinsp = (QcInspection?)ViewBag.Reinspection; var qDoc = (InventoryDoc?)ViewBag.QuarantineDoc; var rDoc = (InventoryDoc?)ViewBag.ReleaseDoc; var origWh = (Warehouse?)ViewBag.OriginalWh;
    Account? counter = Model.Disposition switch
    {
        NcrDisposition.Scrap => await Acc.RuleAccountAsync(PostingCatalog.QcScrap),
        NcrDisposition.ReturnToVendor => await Acc.RuleAccountAsync(PostingCatalog.QcReturnPayable),
        _ => null
    };
}
<div class="doc-head">
    <div>
        <div class="d-flex gap-2 flex-wrap"><span class="badge @QcUi.Badge(Model.Status)">@Model.Status.GetDisplayName()</span>
            <span class="badge @QcUi.Badge(Model.Disposition)">@Model.Disposition.GetDisplayName()</span>
            @if (Model.IsQuarantined) { <span class="badge bg-dark"><i class="bi bi-shield-lock"></i> Đang cách ly</span> }
            @if (Model.IsOverdue) { <span class="badge bg-danger">Quá hạn xử lý</span> }</div>
        <div class="meta mt-1">Lập ngày @Model.Date.ToDate() @if (Model.CreatedBy != null) { <span>bởi @Model.CreatedBy.FullName</span> }
            @if (Model.DueDate.HasValue) { <span>· hạn xử lý @Model.DueDate.ToDate()</span> }
            @if (Model.ClosedAt.HasValue) { <span>· đóng @Model.ClosedAt.Value.ToDateTime() bởi @Model.ClosedBy</span> }</div>
    </div>
    <div class="actions">
        <a class="btn btn-sm btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Danh sách</a>
        @if (canManage && Model.Status == NcrStatus.Open)
        {
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Cập nhật xử lý</a>
            <form asp-action="Close" asp-route-id="@Model.Id" method="post" data-confirm="Đóng NCR?"><button class="btn btn-sm btn-success"><i class="bi bi-check2-circle"></i> Đóng NCR</button></form>
        }
    </div>
</div>

<div class="flow mb-3">
    <span class="step done">Phát hiện</span><span class="arrow">›</span>
    <span class="step @(Model.QuarantinedAt != null ? "done" : "")">Cách ly</span><span class="arrow">›</span>
    <span class="step @(Model.Disposition != NcrDisposition.Pending ? "done" : "current")">Quyết định xử lý</span><span class="arrow">›</span>
    @if (needsStock) { <span class="step @(Model.InventoryDocId != null ? "done" : Model.Disposition != NcrDisposition.Pending ? "current" : "")">Xuất kho @(Model.Disposition == NcrDisposition.Scrap ? "hủy" : "trả NCC")</span><span class="arrow">›</span> }
    <span class="step @(!string.IsNullOrWhiteSpace(Model.CorrectiveAction) ? "done" : "")">Khắc phục / phòng ngừa</span><span class="arrow">›</span>
    <span class="step @(Model.Status == NcrStatus.Closed ? "done" : "")">Đóng</span>
</div>

<div class="row g-3">
    <div class="col-lg-7"><div class="card h-100"><div class="card-body"><dl class="row info mb-0">
        <dt class="col-sm-4">Mặt hàng</dt><dd class="col-sm-8"><b>@Model.Item?.Code</b> – @Model.Item?.Name</dd>
        <dt class="col-sm-4">Số lượng</dt><dd class="col-sm-8"><b>@Model.Quantity.ToQty()</b> @Model.Item?.Unit</dd>
        <dt class="col-sm-4">Kho đang giữ</dt><dd class="col-sm-8">@Model.Warehouse?.Name</dd>
        <dt class="col-sm-4">NCC / khách hàng</dt><dd class="col-sm-8">@Model.Partner?.Name</dd>
        <dt class="col-sm-4">Phiếu kiểm tra</dt><dd class="col-sm-8">@if (Model.Inspection != null) { <a asp-controller="QcInspections" asp-action="Details" asp-route-id="@Model.InspectionId">@Model.Inspection.Number</a> } else { <span>NCR lập thủ công</span> }</dd>
        <dt class="col-sm-4">Mô tả lỗi</dt><dd class="col-sm-8 pre">@Model.Description</dd>
        <dt class="col-sm-4">Nguyên nhân gốc</dt><dd class="col-sm-8 pre">@Model.RootCause</dd>
        <dt class="col-sm-4">Khắc phục / phòng ngừa</dt><dd class="col-sm-8 pre">@Model.CorrectiveAction</dd>
        <dt class="col-sm-4">Người chịu trách nhiệm</dt><dd class="col-sm-8">@Model.Responsible</dd>
    </dl></div></div></div>
    <div class="col-lg-5">
        @if (needsStock)
        {
            <div class="card"><div class="card-header"><i class="bi bi-box-arrow-up me-1"></i> Xuất kho theo hướng xử lý</div><div class="card-body">
                @if (Model.InventoryDoc != null)
                {
                    <p class="mb-1">Đã lập phiếu <a asp-controller="Inventory" asp-action="Details" asp-route-id="@Model.InventoryDocId"><b>@Model.InventoryDoc.Number</b></a> ngày @Model.InventoryDoc.Date.ToDate().</p>
                    <p class="small text-muted mb-0">Bút toán: Nợ @Model.InventoryDoc.CounterAccount?.Code / Có TK kho, giá trị @Model.InventoryDoc.TotalAmount.ToMoney() đ (xem trên phiếu kho).</p>
                    @if (rets.Any())
                    {
                        <hr class="my-2" />
                        <div class="small fw-semibold mb-1">Tác động lên công nợ, thuế và đơn mua</div>
                        <table class="table table-sm small mb-0" data-grid="off"><thead><tr><th>Đơn mua</th><th class="num">SL</th><th class="num">Giá trị</th><th class="num">Thuế hoàn</th><th>Cấn trừ hóa đơn</th></tr></thead><tbody>
                        @foreach (var r in rets)
                        {
                            <tr><td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@r.PurchaseOrderLine?.PurchaseOrderId">@r.PurchaseOrderLine?.PurchaseOrder?.Number</a></td>
                                <td class="num">@r.Quantity.ToQty()</td><td class="num">@r.Amount.ToMoney()</td><td class="num">@(r.VatAmount > 0 ? r.VatAmount.ToMoney() : "")</td>
                                <td>@foreach (var o in r.Offsets) { <div>@(o.Invoice?.InvoiceNo ?? o.Invoice?.Number): @o.Amount.ToMoney()</div> }
                                    @if (r.QtyUnbilled > 0) { <div class="text-muted">@r.QtyUnbilled.ToQty() chưa lập hóa đơn → giảm số lượng phải lập hóa đơn</div> }
                                    @if (r.Unapplied > 0) { <div class="warn">Chưa cấn trừ @r.Unapplied.ToMoney() (hóa đơn đã thanh toán hết – NCC còn nợ lại)</div> }</td></tr>
                        }
                        </tbody></table>
                    }
                }
                else
                {
                    <p class="small">Bút toán sẽ ghi: <b>Nợ @counter?.Code</b> (@counter?.Name) / <b>Có TK kho</b> theo giá vốn bình quân.
                        <a asp-controller="PostingRules" asp-action="Index" asp-fragment="tx-@(Model.Disposition == NcrDisposition.Scrap ? "qc-scrap" : "qc-return")" class="small">Cấu hình bút toán</a></p>
                    @if (Model.Disposition == NcrDisposition.ReturnToVendor)
                    {
                        <p class="small text-muted">Hệ thống đồng thời: ghi giảm công nợ nhà cung cấp theo <b>giá mua</b> (chênh lệch so với giá vốn kho vào TK chênh lệch), hoàn <b>thuế GTGT đầu vào</b> và cấn trừ vào <b>hóa đơn mua</b> đối với phần đã có hóa đơn; phần chưa có hóa đơn giảm số lượng phải lập hóa đơn trên đơn mua.</p>
                    }
                    @if (canExecute && Model.Status == NcrStatus.Open)
                    {
                        <form asp-action="Execute" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 align-items-end" data-confirm="Lập và ghi sổ phiếu xuất kho @Model.Quantity.ToQty() @Model.Item?.Unit?">
                            <div><label class="form-label small mb-0">Ngày xuất</label><input type="date" name="date" value="@DateTime.Today.Iso()" class="form-control form-control-sm" /></div>
                            <button class="btn btn-sm btn-danger"><i class="bi bi-box-arrow-up"></i> Lập phiếu xuất @(Model.Disposition == NcrDisposition.Scrap ? "hủy" : "trả NCC")</button>
                        </form>
                    }
                }
            </div></div>
        }
        else if (Model.Disposition == NcrDisposition.Pending)
        {
            <div class="alert alert-warning">Chưa quyết định hướng xử lý. Chọn: trả lại nhà cung cấp, sửa chữa / làm lại, hủy bỏ hoặc chấp nhận nhân nhượng.</div>
        }
        else
        {
            <div class="alert alert-light border">Hướng xử lý <b>@Model.Disposition.GetDisplayName()</b> không phát sinh nhập / xuất kho.</div>
        }
    </div>
</div>

@{
    var canMgr = (bool)ViewBag.CanManage; var canExe = (bool)ViewBag.CanExecute; var open = Model.Status == NcrStatus.Open;
}
<div class="row g-3 mt-1">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><i class="bi bi-shield-lock me-1"></i> Cách ly</div><div class="card-body">
        @if (Model.QuarantinedAt != null)
        {
            <p class="mb-1">Đã cách ly ngày @Model.QuarantinedAt.ToDate() từ @origWh?.Name sang kho cách ly@(qDoc != null ? "" : ""). @if (qDoc != null) { <a asp-controller="Inventory" asp-action="Details" asp-route-id="@qDoc.Id">@qDoc.Number</a> }</p>
            @if (Model.ReleasedAt != null) { <p class="mb-0 small text-muted">Đã thả cách ly ngày @Model.ReleasedAt.ToDate() về @origWh?.Name. @if (rDoc != null) { <a asp-controller="Inventory" asp-action="Details" asp-route-id="@rDoc.Id">@rDoc.Number</a> }</p> }
            else if (canExe && open && Model.Disposition is NcrDisposition.AcceptAsIs or NcrDisposition.Rework)
            {
                <form asp-action="Release" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 align-items-end" data-confirm="Thả cách ly và chuyển hàng về kho ban đầu?">
                    <div><label class="form-label small mb-0">Ngày thả</label><input type="date" name="date" value="@DateTime.Today.Iso()" class="form-control form-control-sm" /></div>
                    <button class="btn btn-sm btn-success">Thả cách ly</button></form>
            }
            else if (open) { <p class="small text-muted mb-0">Hàng nằm ở kho cách ly. Chọn hướng xử lý: hủy bỏ / trả nhà cung cấp xuất trực tiếp từ kho cách ly; chấp nhận nhân nhượng hoặc sửa chữa thì thả cách ly khi đủ điều kiện.</p> }
        }
        else
        {
            <p class="small text-muted">Chuyển số lượng không phù hợp sang kho cách ly (phiếu chuyển kho) để không bị xuất dùng hoặc giao nhầm trong khi chờ quyết định.</p>
            @if (canExe && open && Model.InventoryDocId == null && Model.WarehouseId != null)
            {
                <form asp-action="Quarantine" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 align-items-end" data-confirm="Chuyển @Model.Quantity.ToQty() sang kho cách ly?">
                    <div><label class="form-label small mb-0">Ngày</label><input type="date" name="date" value="@DateTime.Today.Iso()" class="form-control form-control-sm" /></div>
                    <button class="btn btn-sm btn-dark"><i class="bi bi-shield-lock"></i> Cách ly</button></form>
            }
        }
    </div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><i class="bi bi-wrench-adjustable me-1"></i> Sửa chữa / tái chế</div><div class="card-body">
        @if (Model.Disposition != NcrDisposition.Rework) { <p class="small text-muted mb-0">Áp dụng khi hướng xử lý là <b>Sửa chữa / làm lại</b>: lập phiếu kiểm tra lại, kết luận Đạt mới được thả cách ly và đóng NCR.</p> }
        else if (reinsp != null) { <p class="mb-0">Phiếu kiểm tra lại <a asp-controller="QcInspections" asp-action="Details" asp-route-id="@reinsp.Id"><b>@reinsp.Number</b></a> – <span class="badge @QcUi.Badge(reinsp.Status)">@reinsp.Status.GetDisplayName()</span> @if (reinsp.Status == QcStatus.Completed) { <span class="badge @QcUi.Badge(reinsp.Result)">@reinsp.Result.GetDisplayName()</span> }</p> }
        else if (canMgr && open) { <form asp-action="Reinspect" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-primary">Lập phiếu kiểm tra lại</button></form> }
    </div></div></div>
    <div class="col-12"><div class="card"><div class="card-header"><i class="bi bi-list-check me-1"></i> Hành động khắc phục / phòng ngừa (CAPA)</div><div class="card-body p-0">
        <table class="table table-sm mb-0" data-grid="off"><thead><tr><th>Loại</th><th>Nội dung</th><th>Người phụ trách</th><th>Hạn</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @foreach (var a in actions)
        {
            <tr><td>@a.Kind.GetDisplayName()</td><td>@a.Description @if (!string.IsNullOrEmpty(a.Note)) { <div class="small text-muted">@a.Note</div> }</td><td>@a.Responsible</td><td class="@(a.IsOverdue ? "overdue" : "")">@a.DueDate.ToDate()</td>
                <td>@if (a.Status == QcActionStatus.Done) { <span class="badge bg-success">Hoàn thành @a.DoneAt.ToDate()</span> } else { <span class="badge bg-warning text-dark">@a.Status.GetDisplayName()</span> }</td>
                <td>@if (canMgr && open && a.Status == QcActionStatus.Open) { <form asp-action="CompleteAction" asp-route-id="@Model.Id" method="post" class="d-flex gap-1"><input type="hidden" name="actionId" value="@a.Id" /><input name="note" class="form-control form-control-sm" placeholder="Kết quả" /><button class="btn btn-sm btn-outline-success">Hoàn thành</button></form> }</td></tr>
        }
        @if (!actions.Any()) { <tr><td colspan="6" class="text-muted text-center py-3">Chưa có hành động nào.</td></tr> }
        </tbody></table>
        @if (canMgr && open)
        {
            <form asp-action="AddAction" asp-route-id="@Model.Id" method="post" class="row g-2 p-3 border-top align-items-end">
                <div class="col-md-2"><label class="form-label small">Loại</label><select name="kind" asp-items="Html.GetEnumSelectList<QcActionKind>()" class="form-select form-select-sm"></select></div>
                <div class="col-md-4"><label class="form-label small">Nội dung</label><input name="description" class="form-control form-control-sm" required /></div>
                <div class="col-md-2"><label class="form-label small">Người phụ trách</label><input name="responsible" class="form-control form-control-sm" /></div>
                <div class="col-md-2"><label class="form-label small">Hạn</label><input type="date" name="dueDate" class="form-control form-control-sm" /></div>
                <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Thêm hành động</button></div>
            </form>
        }
    </div></div></div>
</div>
