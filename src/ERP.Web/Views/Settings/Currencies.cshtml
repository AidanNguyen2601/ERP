@model List<Currency>
@{
    ViewData["Title"] = "Tiền tệ & tỷ giá";
    var rates = (List<ExchangeRate>)ViewBag.Rates; var latest = (Dictionary<string, decimal>)ViewBag.Latest;
    var reval = ViewBag.Reval as List<FxService.RevalLine>; DateTime rd = ViewBag.RevalDate;
}
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card mb-3"><div class="card-header">Loại tiền</div><div class="card-body p-0"><table class="table table-sm mb-0" data-grid="off">
            <thead><tr><th>Mã</th><th>Tên</th><th class="num">Số lẻ</th><th class="num">Tỷ giá hiện hành</th><th></th></tr></thead><tbody>
            @foreach (var c in Model)
            {
                <tr class="@(c.IsActive ? "" : "text-muted")"><td><b>@c.Code</b></td><td>@c.Name</td><td class="num">@c.Decimals</td><td class="num">@(c.Code == "VND" ? "1" : latest.GetValueOrDefault(c.Code).ToString("N2"))</td>
                    <td><button type="button" class="btn btn-sm btn-light" onclick="cf('@c.Code','@c.Name',@c.Decimals,@(c.IsActive ? "true" : "false"))"><i class="bi bi-pencil"></i></button></td></tr>
            }
            </tbody></table></div>
            <div class="card-footer"><form asp-action="SaveCurrency" method="post" class="row g-1" id="curForm">
                <div class="col-3"><input name="code" maxlength="3" class="form-control form-control-sm" placeholder="Mã" required /></div>
                <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="Tên" required /></div>
                <div class="col-2"><input name="decimals" type="number" min="0" max="4" value="2" class="form-control form-control-sm" /></div>
                <div class="col-2"><input type="hidden" name="isActive" value="true" /><button class="btn btn-sm btn-primary w-100">Lưu</button></div>
            </form></div>
        </div>
        <div class="card"><div class="card-header">Tỷ giá theo ngày</div>
            <div class="card-body"><form asp-action="SaveRate" method="post" class="row g-1">
                <div class="col-3"><select name="currencyCode" class="form-select form-select-sm">@foreach (var c in Model.Where(c => c.Code != "VND" && c.IsActive)) { <option>@c.Code</option> }</select></div>
                <div class="col-4"><input name="date" type="date" value="@DateTime.Today.Iso()" class="form-control form-control-sm" /></div>
                <div class="col-3"><input name="rate" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="Tỷ giá" required /></div>
                <div class="col-2"><button class="btn btn-sm btn-primary w-100">Thêm</button></div>
            </form>
            <div class="small text-muted mt-1">Nhập nhiều ngày: <a asp-controller="Import" asp-action="Index">nhập tỷ giá từ Excel</a>.</div></div>
            <div style="max-height:360px;overflow:auto"><table class="table table-sm mb-0" data-grid="off"><tbody>
            @foreach (var r in rates)
            {
                <tr><td>@r.Date.ToDate()</td><td>@r.CurrencyCode</td><td class="num">@r.Rate.ToString("N2")</td>
                    <td class="text-end"><form asp-action="DeleteRate" asp-route-id="@r.Id" method="post" data-confirm="Xóa tỷ giá này?"><button class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-x"></i></button></form></td></tr>
            }
            </tbody></table></div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-header">Đánh giá lại khoản mục tiền tệ có gốc ngoại tệ cuối kỳ</div><div class="card-body">
            <form method="get" class="d-flex gap-2 align-items-end mb-2">
                <div><label class="form-label small mb-0">Ngày đánh giá</label><input type="date" name="revalDate" value="@rd.Iso()" class="form-control form-control-sm" /></div>
                <button class="btn btn-sm btn-outline-primary">Xem trước</button>
            </form>
            <div class="small text-muted">Đánh giá lại công nợ hóa đơn ngoại tệ còn dư và số dư tiền ngoại tệ theo tỷ giá tại ngày. Theo Thông tư 99: lãi ghi Có 515, lỗ ghi Nợ 635 (không treo TK 413); hệ thống tự lập bút toán đảo ngày đầu kỳ sau vì công nợ theo dõi theo tỷ giá ghi sổ.
                Chênh lệch đã thực hiện khi thu / trả ghi nhận 515 (lãi) / 635 (lỗ) ngay trên phiếu thu, chi.</div>
            @if (reval != null)
            {
                <table class="table table-sm mt-2 mb-2" data-grid="off">
                    <thead><tr><th>Loại</th><th>Khoản mục</th><th>Tiền</th><th class="num">Số dư ngoại tệ</th><th class="num">Giá trị sổ</th><th class="num">Tỷ giá</th><th class="num">Đánh giá lại</th><th class="num">Chênh lệch</th></tr></thead>
                    <tbody>
                    @foreach (var x in reval) { <tr><td class="small">@x.Kind</td><td class="small">@x.Ref</td><td>@x.Currency</td><td class="num">@x.FcOpen.ToString("N2")</td><td class="num">@x.Book.ToMoney()</td><td class="num">@x.Rate.ToString("N2")</td><td class="num">@x.NewBook.ToMoney()</td><td class="num @(x.Diff < 0 ? "text-danger" : "text-success")">@x.Diff.ToMoney()</td></tr> }
                    @if (!reval.Any()) { <tr><td colspan="8" class="text-muted text-center">Không có chênh lệch cần đánh giá lại.</td></tr> }
                    </tbody>
                </table>
                @if (reval.Any() && User.InAny(AppRoles.Admin + "," + AppRoles.Accountant))
                {
                    <form asp-action="Revalue" method="post" data-confirm="Ghi sổ bút toán đánh giá lại tỷ giá?"><input type="hidden" name="date" value="@rd.Iso()" /><button class="btn btn-sm btn-primary"><i class="bi bi-journal-plus"></i> Ghi sổ đánh giá lại</button></form>
                }
            }
        </div></div>
    </div>
</div>
@section Scripts { <script>function cf(c, n, d, a) { const f = document.getElementById('curForm'); f.code.value = c; f.name.value = n; f.decimals.value = d; f.isActive.value = a; }</script> }
