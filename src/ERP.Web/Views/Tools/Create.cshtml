@model ToolItem
@{ ViewData["Title"] = "Ghi tăng công cụ dụng cụ"; }
<div class="card" style="max-width:960px"><div class="card-body">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Mã CCDC</label><input asp-for="Code" class="form-control" placeholder="Để trống: tự sinh" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label class="form-label">Tên công cụ dụng cụ</label><input asp-for="Name" class="form-control" required /></div>
        <div class="col-md-3"><label class="form-label">Số lượng</label><input asp-for="Quantity" type="number" step="any" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Bộ phận sử dụng</label><input asp-for="Department" class="form-control" list="depts" /><datalist id="depts">@foreach (string d in ViewBag.Depts) { <option value="@d"></option> }</datalist></div>
        <div class="col-md-3"><label class="form-label">Ngày ghi tăng / bắt đầu phân bổ</label><input asp-for="StartDate" type="date" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Tổng giá trị</label><input asp-for="Cost" type="number" step="1000" class="form-control" /><span asp-validation-for="Cost" class="text-danger small"></span></div>
        <div class="col-md-2"><label class="form-label">Số tháng phân bổ</label><input asp-for="Months" type="number" min="1" max="36" class="form-control" /><span asp-validation-for="Months" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">TK chi phí phân bổ</label><select asp-for="ExpenseAccountId" asp-items="ViewBag.Expense" class="form-select"></select></div>
        <div class="col-md-4"><label class="form-label">TK đối ứng khi ghi tăng</label><select name="counterAccountId" asp-items="ViewBag.Counter" class="form-select"><option value="">-- CCDC đầu kỳ (không hạch toán) --</option></select><div class="form-text">153 xuất kho dùng, 331 mua chịu, 111/112 mua trả tiền ngay</div></div>
        <div class="col-md-4"><label class="form-label">Nhà cung cấp (nếu 331)</label><select name="partnerId" asp-items="ViewBag.Partners" class="form-select"><option value="">--</option></select></div>
        <div class="col-12"><label class="form-label">Ghi chú</label><input asp-for="Note" class="form-control" /></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Ghi tăng</button> <a asp-action="Index" class="btn btn-light">Hủy</a></div>
</form>
</div></div>
