@model Equipment
@{
    ViewData["Title"] = $"Thiết bị {Model.Code}"; var can = (bool)ViewBag.CanEdit;
    var plans = (List<MaintenancePlan>)ViewBag.Plans; var orders = (List<MaintenanceOrder>)ViewBag.Orders; var kpi = (EquipmentKpi?)ViewBag.Kpi;
}
<partial name="_MtNav" model="@("eq")" />
<div class="card mb-3"><div class="card-body">
    <div class="doc-head">
        <div><div class="fs-5 fw-semibold">@Model.Code – @Model.Name <span class="badge @(Model.Status == EquipmentStatus.Running ? "bg-success" : Model.Status == EquipmentStatus.Down ? "bg-danger" : Model.Status == EquipmentStatus.UnderMaintenance ? "bg-warning text-dark" : "bg-secondary")">@Model.Status.GetDisplayName()</span></div>
            <div class="meta">@Model.Manufacturer @Model.Model @(string.IsNullOrEmpty(Model.SerialNo) ? "" : "· serial " + Model.SerialNo) · Bộ phận @Model.Department · Vị trí @Model.Location · Mức độ @Model.Criticality.GetDisplayName()
                @(Model.FixedAsset != null ? " · TSCĐ " + Model.FixedAsset.Code : "") @(Model.WorkCenter != null ? " · Chuyền " + Model.WorkCenter.Code : "")</div>
            <div class="meta">Lắp đặt @Model.InstallDate.ToDate() · Bảo hành đến @Model.WarrantyUntil.ToDate() @(Model.ExpenseAccount != null ? " · TK chi phí " + Model.ExpenseAccount.Code : "")</div></div>
        <div class="actions">
            @if (can) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa hồ sơ</a><a class="btn btn-sm btn-outline-secondary" asp-controller="MaintenancePlans" asp-action="Create" asp-route-equipmentId="@Model.Id">+ Kế hoạch bảo dưỡng</a> }
            <a class="btn btn-sm btn-danger" asp-controller="MaintenanceOrders" asp-action="Create" asp-route-equipmentId="@Model.Id" asp-route-kind="Breakdown">Yêu cầu sửa chữa</a>
        </div>
    </div>
    @if (kpi != null)
    {
        <div class="row g-2 mt-1">
            <div class="col-6 col-md-2"><div class="card kpi"><div class="label">Số lần hỏng (12 tháng)</div><div class="value">@kpi.Breakdowns</div></div></div>
            <div class="col-6 col-md-2"><div class="card kpi"><div class="label">Giờ dừng máy</div><div class="value">@kpi.DowntimeHours.ToQty()</div></div></div>
            <div class="col-6 col-md-2"><div class="card kpi"><div class="label">MTBF (giờ)</div><div class="value">@(kpi.Breakdowns == 0 ? "—" : kpi.Mtbf.ToQty())</div></div></div>
            <div class="col-6 col-md-2"><div class="card kpi"><div class="label">MTTR (giờ)</div><div class="value">@(kpi.Breakdowns == 0 ? "—" : kpi.Mttr.ToQty())</div></div></div>
            <div class="col-6 col-md-2"><div class="card kpi"><div class="label">Độ sẵn sàng</div><div class="value">@kpi.Availability.ToPct()</div></div></div>
            <div class="col-6 col-md-2"><div class="card kpi"><div class="label">Chi phí bảo trì</div><div class="value">@kpi.TotalCost.ToShortMoney()</div></div></div>
        </div>
    }
</div></div>
<div class="row g-3 mb-3">
    <div class="col-lg-7"><div class="card h-100"><div class="card-header">Kế hoạch bảo dưỡng</div><div class="card-body p-0"><table class="table table-sm mb-0">
        <thead><tr><th>Nội dung</th><th>Hình thức</th><th class="num">Chu kỳ</th><th>Kế tiếp</th><th>Trạng thái</th></tr></thead><tbody>
        @foreach (var p in plans) { <tr><td>@p.Title</td><td class="small">@p.Kind.GetDisplayName()</td><td class="num">@p.IntervalDays ngày</td><td class="@(p.IsOverdue ? "overdue" : "")">@p.NextDueDate.ToDate()</td><td>@p.Status.GetDisplayName()</td></tr> }
        @if (!plans.Any()) { <tr><td colspan="5" class="text-muted text-center py-3">Chưa có kế hoạch.</td></tr> }
    </tbody></table></div></div></div>
    <div class="col-lg-5"><div class="card h-100"><div class="card-header">Tài liệu / kiểm định trong hồ sơ</div><div class="card-body p-0"><table class="table table-sm mb-0" data-grid="off"><tbody>
        @foreach (var d in Model.Documents.OrderBy(x => x.ExpiryDate))
        {
            <tr><td>@d.Title <span class="small text-muted">@d.DocType @d.Number</span></td><td class="@(d.ExpiryDate < DateTime.Today ? "overdue" : d.ExpiryDate < DateTime.Today.AddDays(45) ? "warn" : "")">@(d.ExpiryDate != null ? "đến " + d.ExpiryDate.ToDate() : "")</td>
                <td>@if (can) { <form asp-action="DeleteDocument" asp-route-id="@Model.Id" method="post" data-confirm="Xóa tài liệu?"><input type="hidden" name="docId" value="@d.Id" /><button class="btn btn-sm btn-link text-danger py-0">✕</button></form> }</td></tr>
        }
        @if (!Model.Documents.Any()) { <tr><td class="text-muted text-center py-3">Chưa có tài liệu.</td></tr> }
        </tbody></table>
        @if (can)
        {
            <form asp-action="AddDocument" asp-route-id="@Model.Id" method="post" class="row g-1 p-2 border-top">
                <div class="col-6"><input name="title" class="form-control form-control-sm" placeholder="Tên tài liệu" required /></div>
                <div class="col-3"><input name="docType" class="form-control form-control-sm" placeholder="Loại" /></div>
                <div class="col-3"><input name="number" class="form-control form-control-sm" placeholder="Số" /></div>
                <div class="col-4"><input type="date" name="issuedDate" class="form-control form-control-sm" title="Ngày cấp" /></div>
                <div class="col-4"><input type="date" name="expiryDate" class="form-control form-control-sm" title="Hết hạn" /></div>
                <div class="col-4"><button class="btn btn-sm btn-primary w-100">Thêm</button></div>
            </form>
        }
    </div></div></div>
</div>
<div class="card"><div class="card-header">Lịch sử bảo dưỡng & sửa chữa</div><div class="card-body p-0"><table class="table table-sm mb-0">
    <thead><tr><th>Số phiếu</th><th>Hình thức</th><th>Nội dung</th><th>Ngày</th><th class="num">Dừng máy (giờ)</th><th class="num">Chi phí</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach (var o in orders) { <tr><td><a asp-controller="MaintenanceOrders" asp-action="Details" asp-route-id="@o.Id">@o.Number</a></td><td class="small">@o.Kind.GetDisplayName()</td><td>@o.Title</td><td>@(o.CompletedAt?.ToDate() ?? o.DueDate.ToDate())</td><td class="num">@(o.DowntimeHours > 0 ? o.DowntimeHours.ToQty() : "")</td><td class="num">@(o.TotalCost > 0 ? o.TotalCost.ToMoney() : "")</td><td>@o.Status.GetDisplayName()</td></tr> }
    @if (!orders.Any()) { <tr><td colspan="7" class="text-muted text-center py-3">Chưa có phiếu.</td></tr> }
</tbody></table></div></div>
