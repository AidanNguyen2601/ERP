@model Equipment
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm thiết bị" : $"Sửa thiết bị {Model.Code}"; }
<partial name="_MtNav" model="@("eq")" />
<div class="card" style="max-width:1000px"><div class="card-body">
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 empty-hide"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<EquipmentStatus>()" class="form-select"></select></div>
        <div class="col-md-3"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="SerialNo" class="form-label"></label><input asp-for="SerialNo" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Criticality" class="form-label"></label><select asp-for="Criticality" asp-items="Html.GetEnumSelectList<Criticality>()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="FixedAssetId" class="form-label"></label><select asp-for="FixedAssetId" asp-items="ViewBag.Assets" class="form-select"><option value="">-- Không liên kết --</option></select><span asp-validation-for="FixedAssetId" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="WorkCenterId" class="form-label"></label><select asp-for="WorkCenterId" asp-items="ViewBag.Centers" class="form-select"><option value="">--</option></select></div>
        <div class="col-md-4"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="InstallDate" class="form-label"></label><input asp-for="InstallDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="WarrantyUntil" class="form-label"></label><input asp-for="WarrantyUntil" type="date" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="ExpenseAccountId" class="form-label"></label><select asp-for="ExpenseAccountId" asp-items="ViewBag.Accounts" class="form-select"><option value="">-- Mặc định theo cấu hình bút toán --</option></select></div>
        <div class="col-12"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" /></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Lưu</button><a class="btn btn-light" asp-action="Index">Hủy</a></div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
