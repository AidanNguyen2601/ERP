@model QcInspection
@{ Layout = null; var cfg = (ErpSettings)ViewBag.Company; }
<!doctype html>
<html lang="vi"><head><meta charset="utf-8" /><title>Giấy chứng nhận chất lượng @Model.CertificateNo</title>
<style>body{font-family:"Times New Roman",serif;font-size:14px;max-width:820px;margin:20px auto;color:#000}h2{text-align:center;margin:14px 0 2px}table{width:100%;border-collapse:collapse;margin-top:10px}th,td{border:1px solid #444;padding:5px 7px}th{background:#eee}.c{text-align:center}.s{display:flex;justify-content:space-around;margin-top:40px;text-align:center}dl{display:grid;grid-template-columns:200px 1fr;gap:3px 10px;margin:8px 0}dt{font-weight:bold}dd{margin:0}.stamp{border:3px double #1a7f37;color:#1a7f37;display:inline-block;padding:6px 18px;font-weight:bold;transform:rotate(-6deg);margin-top:10px}@@media print{button{display:none}}</style></head>
<body>
<div><b>@cfg.CompanyName</b><br />MST: @cfg.CompanyTaxCode<br />@cfg.CompanyAddress</div>
<h2>GIẤY CHỨNG NHẬN CHẤT LƯỢNG</h2>
<div class="c">QUALITY CERTIFICATE<br />Số: <b>@Model.CertificateNo</b> · Ngày @Model.CertificateDate.ToDate()</div>
<dl>
    <dt>Sản phẩm</dt><dd>@Model.Item?.Code – @Model.Item?.Name</dd>
    <dt>Số lô / serial</dt><dd>@(string.IsNullOrEmpty(Model.LotNo) ? "—" : Model.LotNo)</dd>
    <dt>Số lượng được chứng nhận</dt><dd><b>@Model.AcceptedQty.ToQty() @Model.Item?.Unit</b> (lô kiểm tra @Model.LotQty.ToQty(), mẫu @Model.SampleQty.ToQty())</dd>
    <dt>Công đoạn kiểm tra</dt><dd>@Model.Stage.GetDisplayName()</dd>
    <dt>Phiếu kiểm tra</dt><dd>@Model.Number ngày @Model.Date.ToDate() @(string.IsNullOrEmpty(Model.OriginRef) ? "" : " · chứng từ " + Model.OriginRef)</dd>
    <dt>Khách hàng</dt><dd>@Model.Partner?.Name</dd>
    <dt>Kết luận</dt><dd>@Model.Result.GetDisplayName() @(string.IsNullOrWhiteSpace(Model.Note) ? "" : "– " + Model.Note)</dd>
</dl>
<table><thead><tr><th>STT</th><th>Chỉ tiêu</th><th>Phương pháp</th><th>Tiêu chuẩn</th><th>Kết quả đo</th><th>Đánh giá</th></tr></thead><tbody>
@foreach (var l in Model.Lines.OrderBy(x => x.Seq)) { <tr><td class="c">@l.Seq</td><td>@l.Name</td><td>@l.Method</td><td>@l.Standard</td><td class="c">@(l.MeasuredValue.HasValue ? l.MeasuredValue.Value.ToQty() + " " + l.Unit : "—")</td><td class="c">@(l.Passed == true ? "Đạt" : l.Passed == false ? "Không đạt" : "—")</td></tr> }
@if (!Model.Lines.Any()) { <tr><td colspan="6" class="c">Kiểm tra theo số lượng đạt / không đạt.</td></tr> }
</tbody></table>
<div class="c"><span class="stamp">ĐẠT TIÊU CHUẨN CHẤT LƯỢNG</span></div>
<div class="s"><div><b>Người kiểm tra (KCS)</b><br />@Model.Inspector?.FullName</div><div><b>Người cấp giấy</b><br />@ViewBag.IssuedBy</div><div><b>Giám đốc</b><br /><i>(Ký, đóng dấu)</i></div></div>
<p><button onclick="window.print()">In giấy chứng nhận</button></p>
</body></html>
