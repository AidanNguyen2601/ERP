@model List<SalesOrder>
@{ ViewData["Title"] = "Đơn bán hàng"; var counts = (Dictionary<SoStatus, int>)ViewBag.Counts; var st = ViewBag.Status as SoStatus?; }
<div class="subnav">
    <a class="@(st == null ? "active" : "")" asp-action="Index">Tất cả</a>
    @foreach (SoStatus s in Enum.GetValues<SoStatus>()) { if (counts.ContainsKey(s)) { <a class="@(st == s ? "active" : "")" asp-action="Index" asp-route-status="@s">@s.GetDisplayName() (@counts[s])</a> } }
</div>
<form class="toolbar" method="get"><input type="hidden" name="status" value="@st" />
    <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" style="width:260px" placeholder="Số đơn, khách hàng" /><button class="btn btn-sm btn-outline-primary">Tìm</button>
    @if ((bool)ViewBag.CanEdit) { <a class="btn btn-sm btn-primary ms-auto" asp-action="Create">+ Đơn bán hàng</a> }
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Số đơn</th><th>Ngày</th><th>Khách hàng</th><th>Ngày giao</th><th class="num">Tổng tiền</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr><td><a asp-action="Details" asp-route-id="@s.Id">@s.Number</a></td><td>@s.Date.ToDate()</td><td>@s.Customer?.Name</td>
            <td class="@(s.DeliveryDate < DateTime.Today && s.Status is SoStatus.Confirmed or SoStatus.PartiallyDelivered ? "overdue" : "")">@s.DeliveryDate.ToDate()</td>
            <td class="num">@s.Total.ToMoney()</td><td><partial name="_Badge" model="s.Status" /></td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Không có đơn.</td></tr> }
    </tbody>
</table></div></div></div>
<partial name="_PagerBag" />
