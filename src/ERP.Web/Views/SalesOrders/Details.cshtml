@model SalesOrder
@{
    ViewData["Title"] = $"Đơn bán {Model.Number}";
    var dels = (List<InventoryDoc>)ViewBag.Deliveries; var invs = (List<Invoice>)ViewBag.Invoices; var stock = (Dictionary<int, decimal>)ViewBag.Stock;
    var canEdit = (bool)ViewBag.CanEdit; var canDel = (bool)ViewBag.CanDeliver; var canOv = (bool)ViewBag.CanOverride; var canAcc = User.CanAccounting();
    var steps = new[] { SoStatus.Draft, SoStatus.Confirmed, SoStatus.PartiallyDelivered, SoStatus.Delivered, SoStatus.Completed };
    var cur = Array.IndexOf(steps, Model.Status);
    var toBill = Model.Lines.Sum(l => l.DeliveredQty - l.InvoicedQty);
}
<div class="flow mb-3">
@for (var i = 0; i < steps.Length; i++) { if (i > 0) { <span class="arrow">›</span> } <span class="step @(Model.Status == SoStatus.Cancelled ? "" : i < cur ? "done" : i == cur ? "current" : "")">@steps[i].GetDisplayName()</span> }
@if (Model.Status == SoStatus.Cancelled) { <span class="badge bg-dark ms-2">Đã hủy</span> }
</div>
@if (ViewBag.Exposure is ValueTuple<decimal, decimal, decimal, decimal> ex)
{
    var over = ex.Item3 > ex.Item4;
    <div class="alert @(over ? "alert-danger" : "alert-info") py-2">Hạn mức công nợ khách hàng: dư nợ @ex.Item1.ToMoney() + đơn đang mở @ex.Item2.ToMoney() + đơn này @Model.Total.ToMoney() = <b>@ex.Item3.ToMoney()</b> / hạn mức @ex.Item4.ToMoney().
        @(over ? (canOv ? " Vượt hạn mức – bạn có quyền duyệt vượt khi xác nhận." : " Vượt hạn mức – cần Ban Giám đốc xác nhận.") : "")</div>
}
<div class="card mb-3"><div class="card-body">
    <div class="doc-head">
        <div><div class="fs-5 fw-semibold">@Model.Number <partial name="_Badge" model="Model.Status" /></div>
            <div class="meta">Khách hàng <b>@Model.Customer?.Name</b> · Kho xuất @Model.Warehouse?.Name · Ngày đơn @Model.Date.ToDate() · Ngày giao @Model.DeliveryDate.ToDate() · Lập bởi @Model.CreatedBy?.FullName</div>
            @if (Model.CreditApprovedBy != null) { <div class="meta text-danger">Duyệt vượt hạn mức công nợ: @Model.CreditApprovedBy.FullName</div> }
            @if (!string.IsNullOrWhiteSpace(Model.Note)) { <div>@Model.Note</div> }</div>
        <div class="actions">
            @if (canEdit && Model.Status == SoStatus.Draft) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a> }
            @if ((canEdit || canOv) && Model.Status == SoStatus.Draft) { <form asp-action="Confirm" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-primary">Xác nhận đơn</button></form> }
            @if (canDel && Model.Status is SoStatus.Confirmed or SoStatus.PartiallyDelivered) { <a class="btn btn-sm btn-primary" asp-action="Deliver" asp-route-id="@Model.Id">Giao hàng / xuất kho</a> }
            @if (canAcc && toBill > 0) { <form asp-action="CreateInvoice" asp-route-id="@Model.Id" method="post"><input type="hidden" name="issue" value="true" /><button class="btn btn-sm btn-success">Xuất hóa đơn</button></form> }
            @if (canEdit && Model.Status is SoStatus.Draft or SoStatus.Confirmed && Model.Lines.All(l => l.DeliveredQty == 0)) { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" data-confirm="Hủy đơn bán?"><button class="btn btn-sm btn-outline-danger">Hủy đơn</button></form> }
        </div>
    </div>
    <table class="table table-sm">
        <thead><tr><th>Mã</th><th>Tên hàng</th><th>ĐVT</th><th class="num">SL</th><th class="num">Tồn kho xuất</th><th class="num">Đã giao</th><th class="num">Đã xuất HĐ</th><th class="num">Đơn giá</th><th class="num">CK</th><th class="num">VAT</th><th class="num">Thành tiền</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            var s = stock.GetValueOrDefault(l.ItemId); var rem = l.Quantity - l.DeliveredQty;
            <tr><td>@l.Item?.Code</td><td>@l.Item?.Name</td><td>@l.Item?.Unit</td><td class="num">@l.Quantity.ToQty()</td>
                <td class="num @(l.Item!.IsStocked && rem > s ? "bad" : "")">@(l.Item.IsStocked ? s.ToQty() : "—")</td>
                <td class="num @(l.DeliveredQty >= l.Quantity ? "good" : l.DeliveredQty > 0 ? "warn" : "")">@l.DeliveredQty.ToQty()</td><td class="num">@l.InvoicedQty.ToQty()</td>
                <td class="num">@l.UnitPrice.ToMoney()</td><td class="num">@(l.DiscountPct > 0 ? l.DiscountPct.ToPct() : "")</td><td class="num">@l.VatRate%</td><td class="num">@l.Amount.ToMoney()</td></tr>
        }
        </tbody>
        <tfoot>
            <tr><td colspan="10" class="text-end">Tiền hàng (sau chiết khấu)</td><td class="num">@Model.Subtotal.ToMoney()</td></tr>
            <tr><td colspan="10" class="text-end">Thuế GTGT</td><td class="num">@Model.VatAmount.ToMoney()</td></tr>
            <tr class="fw-bold"><td colspan="10" class="text-end">Tổng cộng</td><td class="num">@Model.Total.ToMoney()</td></tr>
        </tfoot>
    </table>
</div></div>
<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Phiếu xuất kho</div><div class="card-body p-0"><table class="table table-sm mb-0"><tbody>
        @foreach (var d in dels) { <tr><td>@d.Date.ToDate()</td><td><a asp-controller="Inventory" asp-action="Details" asp-route-id="@d.Id">@d.Number</a></td><td class="num">Giá vốn @d.TotalAmount.ToMoney()</td></tr> }
        @if (!dels.Any()) { <tr><td class="text-muted text-center py-3">Chưa giao hàng.</td></tr> }
    </tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Hóa đơn</div><div class="card-body p-0"><table class="table table-sm mb-0"><tbody>
        @foreach (var i in invs) { <tr><td>@i.Date.ToDate()</td><td>@if (User.SeesFinance()) { <a asp-controller="Invoices" asp-action="Details" asp-route-id="@i.Id">@i.Series @(i.InvoiceNo ?? i.Number)</a> } else { @(i.InvoiceNo ?? i.Number) }</td><td class="num">@i.Total.ToMoney()</td><td class="num small">còn @i.Outstanding.ToMoney()</td><td><partial name="_Badge" model="i.Status" /></td></tr> }
        @if (!invs.Any()) { <tr><td class="text-muted text-center py-3">Chưa xuất hóa đơn.</td></tr> }
    </tbody></table></div></div></div>
</div>
