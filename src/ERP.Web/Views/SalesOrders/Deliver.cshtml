@model SalesOrder
@{ ViewData["Title"] = $"Giao hàng – đơn bán {Model.Number}"; var stock = (Dictionary<int, decimal>)ViewBag.Stock; }
<div class="card" style="max-width:1000px"><div class="card-body">
<div class="meta mb-2">Khách hàng <b>@Model.Customer?.Name</b> · xuất từ <b>@Model.Warehouse?.Name</b></div>
<form asp-action="Deliver" asp-route-id="@Model.Id" method="post">
    <div class="row g-2 mb-3"><div class="col-md-3"><label class="form-label small">Ngày xuất kho</label><input type="date" name="date" value="@DateTime.Today.Iso()" class="form-control form-control-sm" /></div></div>
    <table class="table table-sm align-middle">
        <thead><tr><th>Mã</th><th>Tên hàng</th><th class="num">Đặt</th><th class="num">Đã giao</th><th class="num">Còn lại</th><th class="num">Tồn kho</th><th style="width:160px" class="text-end">Giao lần này</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            var rem = l.Quantity - l.DeliveredQty; var s = stock.GetValueOrDefault(l.ItemId);
            var def = l.Item!.IsStocked ? Math.Min(rem, Math.Max(0, s)) : rem;
            <tr><td>@l.Item.Code</td><td>@l.Item.Name</td><td class="num">@l.Quantity.ToQty()</td><td class="num">@l.DeliveredQty.ToQty()</td><td class="num">@rem.ToQty()</td>
                <td class="num @(l.Item.IsStocked && s < rem ? "bad" : "")">@(l.Item.IsStocked ? s.ToQty() : "dịch vụ")</td>
                <td><input type="number" name="qty[@l.Id]" value="@def.Raw()" min="0" max="@rem.Raw()" step="0.001" class="form-control form-control-sm text-end" @(rem <= 0 ? "readonly" : "") /></td></tr>
        }
        </tbody>
    </table>
    <button class="btn btn-primary">Xác nhận xuất kho</button> <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Hủy</a>
    <div class="small text-muted mt-2">Ghi sổ giá vốn: Nợ 632 / Có 155 (thành phẩm) hoặc 1561 (hàng hóa) theo giá vốn bình quân.</div>
</form>
</div></div>
