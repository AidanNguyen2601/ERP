@model List<ProductionOrder>
@{
    ViewData["Title"] = "Lệnh sản xuất"; var counts = (Dictionary<ProductionStatus, int>)ViewBag.Counts; var tcounts = (Dictionary<ProductionType, int>)ViewBag.TypeCounts;
    var st = ViewBag.Status as ProductionStatus?; var tp = ViewBag.Type as ProductionType?;
}
<partial name="_MfgNav" model="@("mo")" />
<div class="toolbar">
    @if ((bool)ViewBag.CanEdit) { <a class="btn btn-sm btn-primary order-last ms-auto" asp-action="Create">+ Lệnh sản xuất</a> }
    <a class="btn btn-sm @(st == null ? "btn-secondary" : "btn-light border")" asp-action="Index" asp-route-type="@tp">Tất cả</a>
    @foreach (ProductionStatus s in Enum.GetValues<ProductionStatus>()) { if (counts.ContainsKey(s)) { <a class="btn btn-sm @(st == s ? "btn-secondary" : "btn-light border")" asp-action="Index" asp-route-status="@s" asp-route-type="@tp">@s.GetDisplayName() (@counts[s])</a> } }
    <span class="mx-2 text-muted">|</span>
    <a class="btn btn-sm @(tp == null ? "btn-secondary" : "btn-light border")" asp-action="Index" asp-route-status="@st">Mọi hình thức</a>
    @foreach (ProductionType t in Enum.GetValues<ProductionType>()) { <a class="btn btn-sm @(tp == t ? "btn-secondary" : "btn-light border")" asp-action="Index" asp-route-status="@st" asp-route-type="@t">@(t == ProductionType.MakeToOrder ? "MTO" : "MTS") (@tcounts.GetValueOrDefault(t))</a> }
</div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Số lệnh</th><th>Thành phẩm</th><th class="num">Số lượng</th><th>Hình thức</th><th>Bắt đầu</th><th>Hoàn thành DK</th><th style="width:120px">Xuất NVL</th><th style="width:120px">Tiến độ</th><th class="num">Giá thành / SP</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        var req = p.Lines.Sum(l => l.RequiredQty); var pct = req == 0 ? 0 : (int)(p.Lines.Sum(l => Math.Min(l.IssuedQty, l.RequiredQty)) * 100 / req);
        var prog = ManufacturingService.Progress(p);
        <tr><td><a asp-action="Details" asp-route-id="@p.Id">@p.Number</a>@(p.ParentOrderId != null ? " ↳" : "")</td><td>@p.Item?.Name @if (p.Item?.Type == ItemType.SemiFinished) { <span class="badge bg-warning text-dark">BTP</span> }</td><td class="num">@p.Quantity.ToQty()</td>
            <td><span class="badge @(p.OrderType == ProductionType.MakeToOrder ? "bg-primary" : "bg-secondary")">@(p.OrderType == ProductionType.MakeToOrder ? "MTO" : "MTS")</span></td><td>@p.StartDate.ToDate()</td>
            <td class="@(p.DueDate < DateTime.Today && p.Status is ProductionStatus.Released or ProductionStatus.InProgress ? "overdue" : "")">@p.DueDate.ToDate()</td>
            <td><div class="progress"><div class="progress-bar" style="width:@pct%"></div></div></td>
            <td><div class="progress"><div class="progress-bar bg-success" style="width:@prog%"></div></div></td>
            <td class="num">@(p.UnitCost > 0 ? p.UnitCost.ToMoney() : "")</td><td><partial name="_Badge" model="p.Status" /></td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">Không có lệnh.</td></tr> }
    </tbody>
</table></div></div></div>
<partial name="_PagerBag" />
