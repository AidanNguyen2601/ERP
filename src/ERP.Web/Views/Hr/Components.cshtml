@model List<SalaryComponent>
@{ ViewData["Title"] = "Thành phần lương"; var e = (SalaryComponent)ViewBag.Edit; var can = (bool)ViewBag.CanEdit; var assigned = (List<EmployeeSalaryComponent>)ViewBag.Assigned; }
<partial name="_HrNav" model="@("comp")" />
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-header">Khoản lương (phụ cấp, thưởng, khấu trừ)</div><div class="card-body p-0"><table class="table table-sm table-hover mb-0">
            <thead><tr><th>Mã</th><th>Tên</th><th>Loại</th><th>Thuế TNCN</th><th>Công thức</th><th></th></tr></thead><tbody>
            @foreach (var c in Model) { <tr class="@(c.IsActive ? "" : "text-muted")"><td>@c.Code</td><td>@c.Name <div class="small text-muted">@c.Note</div></td><td class="small">@c.Kind.GetDisplayName()</td><td>@(c.Kind == ComponentKind.Deduction ? "—" : c.Taxable ? "Chịu thuế" : "Không chịu thuế")</td><td><code>@(c.Formula ?? "(số tiền cố định theo nhân viên)")</code></td><td>@if (can) { <a class="small" asp-action="Components" asp-route-edit="@c.Id">Sửa</a> }</td></tr> }
            @if (!Model.Any()) { <tr><td colspan="6" class="text-muted text-center py-3">Chưa có khoản lương.</td></tr> }
        </tbody></table></div></div>
        <div class="card"><div class="card-header">Gán cho nhân viên</div><div class="card-body p-0"><table class="table table-sm mb-0"><thead><tr><th>Nhân viên</th><th>Khoản</th><th class="num">Số tiền / hệ số</th><th></th></tr></thead><tbody>
            @foreach (var a in assigned) { <tr><td>@a.Employee?.Code <span class="small text-muted">@a.Employee?.FullName</span></td><td>@a.Component?.Code – @a.Component?.Name</td><td class="num">@(a.Amount != 0 ? a.Amount.ToMoney() : "—")</td><td>@if (can) { <form asp-action="Unassign" asp-route-id="@a.Id" method="post"><button class="btn btn-sm btn-link text-danger py-0">✕</button></form> }</td></tr> }
            @if (!assigned.Any()) { <tr><td colspan="4" class="text-muted text-center py-3">Chưa gán.</td></tr> }
        </tbody></table>
        @if (can)
        {
            <form asp-action="Assign" method="post" class="row g-1 p-2 border-top"><div class="col-md-4"><select name="employeeId" asp-items="ViewBag.Emps" class="form-select form-select-sm"></select></div><div class="col-md-4"><select name="salaryComponentId" asp-items="ViewBag.Comps" class="form-select form-select-sm"></select></div>
                <div class="col-md-2"><input type="number" step="1" name="amount" value="0" class="form-control form-control-sm" title="Số tiền cố định, hoặc hệ số nhân của công thức (0 = 1)" /></div><div class="col-md-2"><button class="btn btn-sm btn-outline-primary w-100">Gán</button></div></form>
        }
        </div></div>
    </div>
    @if (can)
    {
        <div class="col-lg-4"><div class="card"><div class="card-header">@(e.Id == 0 ? "Thêm khoản lương" : "Sửa " + e.Code)</div><div class="card-body">
            <form asp-action="SaveComponent" method="post" class="row g-2"><input type="hidden" name="Id" value="@e.Id" />
                <div class="col-4"><label class="form-label small">Mã</label><input name="Code" value="@e.Code" class="form-control form-control-sm" /></div>
                <div class="col-8"><label class="form-label small">Tên khoản</label><input name="Name" value="@e.Name" class="form-control form-control-sm" /></div>
                <div class="col-7"><label class="form-label small">Loại</label><select name="Kind" asp-items="Html.GetEnumSelectList<ComponentKind>()" class="form-select form-select-sm"></select></div>
                <div class="col-5 pt-4"><div class="form-check"><input type="checkbox" class="form-check-input" name="Taxable" value="true" @(e.Taxable ? "checked" : "") /><input type="hidden" name="Taxable" value="false" /><label class="form-check-label small">Chịu thuế</label></div></div>
                <div class="col-12"><label class="form-label small">Công thức (để trống = số tiền cố định)</label><input name="Formula" id="formula" value="@e.Formula" class="form-control form-control-sm" placeholder="VD: BaseSalary * 0.1 + Years * 100000" /></div>
                <div class="col-8"><select id="testEmp" asp-items="ViewBag.Emps" class="form-select form-select-sm"></select></div><div class="col-4"><button type="button" id="testBtn" class="btn btn-sm btn-outline-secondary w-100">Thử</button></div>
                <div class="col-12 small" id="testOut"></div>
                <div class="col-12"><input name="Note" value="@e.Note" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
                <div class="col-12"><div class="form-check"><input type="checkbox" class="form-check-input" name="IsActive" value="true" @(e.IsActive ? "checked" : "") /><input type="hidden" name="IsActive" value="false" /><label class="form-check-label small">Đang sử dụng</label></div></div>
                <div class="col-12"><button class="btn btn-sm btn-primary">Lưu</button> @if (e.Id != 0) { <a class="btn btn-sm btn-light" asp-action="Components">Hủy</a> }</div>
            </form>
            <div class="small text-muted mt-2">Biến: <code>@string.Join(", ", FormulaEvaluator.Variables)</code>. Phép tính + − * / ( ), so sánh, hàm <code>MIN(a;b)</code>, <code>MAX</code>, <code>ROUND</code>, <code>IF(điều kiện; a; b)</code>. VD thưởng chuyên cần: <code>IF(WorkDays >= StdDays; 500000; 0)</code>. Số tiền khi gán (khác 0) nhân với kết quả công thức.</div>
        </div></div></div>
    }
</div>
@section Scripts { <script>
document.getElementById('testBtn')?.addEventListener('click', async () => {
    const f = document.getElementById('formula').value, emp = document.getElementById('testEmp').value;
    const r = await (await fetch('@Url.Action("TestFormula")?formula=' + encodeURIComponent(f) + '&employeeId=' + emp)).json();
    document.getElementById('testOut').innerHTML = r.error ? '<span class="text-danger">' + r.error + '</span>' : 'Kết quả: <b>' + Number(r.value).toLocaleString('vi-VN') + '</b>';
});
</script> }
