@model List<ERP.Web.Controllers.HrController.PitRow>
@{ ViewData["Title"] = "Quyết toán thuế TNCN"; int y = ViewBag.Year; }
<partial name="_HrNav" model="@("pit")" />
<div class="toolbar"><a class="btn btn-sm btn-light border" asp-action="PitFinalization" asp-route-year="@(y - 1)">‹</a><b class="px-2">Năm @y</b><a class="btn btn-sm btn-light border" asp-action="PitFinalization" asp-route-year="@(y + 1)">›</a>
    <a class="btn btn-sm btn-outline-success ms-auto" asp-action="PitFinalization" asp-route-year="@y" asp-route-excel="true"><i class="bi bi-file-earmark-excel"></i> Xuất Excel (05/QTT-TNCN)</a></div>
<div class="alert alert-info small py-2">Thu nhập tính thuế cả năm = tổng thu nhập − khoản không chịu thuế − phần làm thêm giờ được miễn − bảo hiểm bắt buộc − giảm trừ gia cảnh (số tháng có lương × mức giảm trừ). Thuế tính theo biểu lũy tiến cả năm (ngưỡng tháng × 12) từ các bảng lương đã hạch toán; chênh lệch với thuế đã khấu trừ hàng tháng là số phải nộp thêm (+) hoặc được hoàn (−).</div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
    <thead><tr><th>Mã</th><th>Họ tên</th><th>MST</th><th class="num">Tháng</th><th class="num">Tổng thu nhập</th><th class="num">Không chịu thuế</th><th class="num">Miễn (OT)</th><th class="num">Bảo hiểm</th><th class="num">Giảm trừ GC</th><th class="num">TN tính thuế</th><th class="num">Thuế cả năm</th><th class="num">Đã khấu trừ</th><th class="num">Phải nộp (+) / hoàn (−)</th></tr></thead><tbody>
    @foreach (var x in Model) { <tr><td>@x.Employee.Code</td><td>@x.Employee.FullName</td><td class="small">@x.Employee.PersonalTaxCode</td><td class="num">@x.Months</td><td class="num">@x.Gross.ToMoney()</td><td class="num">@x.NonTax.ToMoney()</td><td class="num">@x.Exempt.ToMoney()</td><td class="num">@x.Insurance.ToMoney()</td><td class="num">@x.Family.ToMoney()</td><td class="num">@x.Taxable.ToMoney()</td><td class="num">@x.AnnualTax.ToMoney()</td><td class="num">@x.Withheld.ToMoney()</td><td class="num fw-bold @(x.Difference > 0 ? "bad" : x.Difference < 0 ? "good" : "")">@x.Difference.ToMoney()</td></tr> }
    @if (!Model.Any()) { <tr><td colspan="13" class="text-center text-muted py-4">Chưa có bảng lương đã hạch toán trong năm.</td></tr> }
    </tbody>
    @if (Model.Any()) { <tfoot><tr class="fw-bold"><td colspan="4" class="text-end">Cộng</td><td class="num">@Model.Sum(x => x.Gross).ToMoney()</td><td class="num">@Model.Sum(x => x.NonTax).ToMoney()</td><td class="num">@Model.Sum(x => x.Exempt).ToMoney()</td><td class="num">@Model.Sum(x => x.Insurance).ToMoney()</td><td class="num">@Model.Sum(x => x.Family).ToMoney()</td><td class="num">@Model.Sum(x => x.Taxable).ToMoney()</td><td class="num">@Model.Sum(x => x.AnnualTax).ToMoney()</td><td class="num">@Model.Sum(x => x.Withheld).ToMoney()</td><td class="num">@Model.Sum(x => x.Difference).ToMoney()</td></tr></tfoot> }
</table></div></div></div>
