@model List<Company>
@{
    ViewData["Title"] = "Công ty & chi nhánh";
    var counts = (Dictionary<int, int>)ViewBag.Counts; var users = (Dictionary<int, int>)ViewBag.Users;
    var whs = (List<Warehouse>)ViewBag.Warehouses; var cas = (List<CashAccount>)ViewBag.CashAccounts;
    var branches = Model.SelectMany(c => c.Branches).OrderBy(b => b.Code).ToList();
    var admin = User.IsAdmin();
}
<div class="alert alert-info small">Mỗi chứng từ thuộc một chi nhánh (theo chi nhánh người lập đang chọn, hoặc theo kho / quỹ). Người dùng bị giới hạn chi nhánh chỉ thấy chứng từ của chi nhánh mình;
    báo cáo tài chính lọc theo chi nhánh đang chọn ở thanh trên cùng. Báo cáo hợp nhất cộng các công ty và loại trừ giao dịch nội bộ.</div>
@foreach (var c in Model)
{
    <div class="card mb-3"><div class="card-header d-flex justify-content-between"><span><i class="bi bi-buildings me-1"></i><b>@c.Code</b> – @c.Name @if (c.IsParent) { <span class="badge bg-primary ms-1">Công ty mẹ</span> } else { <span class="badge bg-light text-dark border ms-1">Sở hữu @c.OwnershipPct.ToPct()</span> }</span>
        <span class="small text-muted fw-normal">MST @c.TaxCode · @c.Address</span></div>
        <div class="card-body p-0"><table class="table table-sm mb-0" data-grid="off"><thead><tr><th>Mã chi nhánh</th><th>Tên</th><th>Địa chỉ</th><th class="num">Bút toán</th><th class="num">Người dùng</th><th>Trạng thái</th></tr></thead><tbody>
        @foreach (var b in c.Branches.OrderBy(x => x.Code))
        {
            <tr><td><b>@b.Code</b></td><td>@b.Name</td><td class="small">@b.Address</td><td class="num">@counts.GetValueOrDefault(b.Id)</td><td class="num">@users.GetValueOrDefault(b.Id)</td><td>@(b.IsActive ? "Hoạt động" : "Ngưng")</td></tr>
        }
        </tbody></table></div></div>
}
@if (admin)
{
    <div class="row g-3">
        <div class="col-lg-6"><div class="card"><div class="card-header">Thêm / sửa công ty</div><div class="card-body">
            <form asp-action="SaveCompany" method="post" class="row g-2">
                <div class="col-4"><label class="form-label small">Sửa công ty</label><select name="Id" class="form-select form-select-sm"><option value="0">(Thêm mới)</option>@foreach (var c in Model) { <option value="@c.Id">@c.Code</option> }</select></div>
                <div class="col-4"><label class="form-label small">Mã</label><input name="Code" class="form-control form-control-sm" required /></div>
                <div class="col-4"><label class="form-label small">Mã số thuế</label><input name="TaxCode" class="form-control form-control-sm" /></div>
                <div class="col-12"><label class="form-label small">Tên công ty</label><input name="Name" class="form-control form-control-sm" required /></div>
                <div class="col-12"><label class="form-label small">Địa chỉ</label><input name="Address" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Tỷ lệ sở hữu (%)</label><input name="OwnershipPct" type="number" value="100" class="form-control form-control-sm" /></div>
                <div class="col-8 d-flex align-items-end gap-3"><div class="form-check"><input class="form-check-input" type="checkbox" name="IsParent" value="true" id="ip"><label class="form-check-label small" for="ip">Công ty mẹ</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" id="ia" checked><label class="form-check-label small" for="ia">Hoạt động</label></div></div>
                <div class="col-12"><button class="btn btn-sm btn-primary">Lưu công ty</button></div>
            </form></div></div></div>
        <div class="col-lg-6"><div class="card"><div class="card-header">Thêm / sửa chi nhánh</div><div class="card-body">
            <form asp-action="SaveBranch" method="post" class="row g-2">
                <div class="col-4"><label class="form-label small">Sửa chi nhánh</label><select name="Id" class="form-select form-select-sm"><option value="0">(Thêm mới)</option>@foreach (var b in branches) { <option value="@b.Id">@b.Code</option> }</select></div>
                <div class="col-4"><label class="form-label small">Thuộc công ty</label><select name="CompanyId" class="form-select form-select-sm">@foreach (var c in Model) { <option value="@c.Id">@c.Code</option> }</select></div>
                <div class="col-4"><label class="form-label small">Mã</label><input name="Code" class="form-control form-control-sm" required /></div>
                <div class="col-12"><label class="form-label small">Tên chi nhánh</label><input name="Name" class="form-control form-control-sm" required /></div>
                <div class="col-12"><label class="form-label small">Địa chỉ</label><input name="Address" class="form-control form-control-sm" /></div>
                <input type="hidden" name="IsActive" value="true" />
                <div class="col-12"><button class="btn btn-sm btn-primary">Lưu chi nhánh</button></div>
            </form></div></div></div>
        <div class="col-12"><div class="card"><div class="card-header">Kho và quỹ / tài khoản ngân hàng theo chi nhánh</div><div class="card-body p-0"><table class="table table-sm align-middle mb-0" data-grid="off"><tbody>
            @foreach (var w in whs)
            {
                <tr><td><i class="bi bi-houses"></i> Kho <b>@w.Code</b> – @w.Name</td><td style="width:340px"><form asp-action="Assign" method="post" class="d-flex gap-1"><input type="hidden" name="kind" value="wh" /><input type="hidden" name="id" value="@w.Id" />
                    <select name="branchId" class="form-select form-select-sm">@foreach (var b in branches) { <option value="@b.Id" selected="@(w.BranchId == b.Id)">@b.Code – @b.Name</option> }</select><button class="btn btn-sm btn-light border">Lưu</button></form></td></tr>
            }
            @foreach (var ca in cas)
            {
                <tr><td><i class="bi bi-wallet2"></i> Quỹ / TK <b>@ca.Code</b> – @ca.Name <span class="badge bg-light text-dark border">@ca.CurrencyCode</span></td><td><form asp-action="Assign" method="post" class="d-flex gap-1"><input type="hidden" name="kind" value="ca" /><input type="hidden" name="id" value="@ca.Id" />
                    <select name="branchId" class="form-select form-select-sm">@foreach (var b in branches) { <option value="@b.Id" selected="@(ca.BranchId == b.Id)">@b.Code – @b.Name</option> }</select><button class="btn btn-sm btn-light border">Lưu</button></form></td></tr>
            }
        </tbody></table></div></div></div>
    </div>
}
