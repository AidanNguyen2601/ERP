@{
    ViewData["Title"] = "Ma trận phân quyền";
    var users = (List<AppUser>)ViewBag.Users;
    var roles = AppRoles.All;
    System.Security.Claims.ClaimsPrincipal Fake(string role) => new(new System.Security.Claims.ClaimsIdentity(new[] { new System.Security.Claims.Claim(System.Security.Claims.ClaimTypes.Role, role) }, "x"));
}
<p class="small text-muted">Quyền theo <b>chức năng</b>: mỗi vai trò thấy các chức năng dưới đây (một số thao tác ghi sổ, duyệt còn kiểm tra thêm ở từng màn hình). Quyền theo <b>dữ liệu / đơn vị</b>: người dùng bị giới hạn chi nhánh chỉ thấy chứng từ chi nhánh mình.
    <b>Duyệt</b>: theo <a asp-controller="Approvals" asp-action="Rules">quy tắc phê duyệt</a>.</p>
<div class="card mb-3"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-bordered mb-0 small" data-grid="off">
    <thead><tr><th>Nhóm / chức năng</th>@foreach (var r in roles) { <th class="text-center">@AppRoles.DisplayName(r)</th> }</tr></thead>
    <tbody>
    @foreach (var g in Menu.Groups)
    {
        <tr class="table-light"><td colspan="@(roles.Length + 1)" class="fw-semibold"><i class="bi @g.Icon me-1"></i>@g.Title</td></tr>
        foreach (var i in g.Items)
        {
            <tr><td class="ps-4">@i.Title</td>@foreach (var r in roles) { var ok = i.Visible == null || i.Visible(Fake(r)); <td class="text-center">@if (ok) { <i class="bi bi-check-lg good"></i> }</td> }</tr>
        }
    }
    </tbody>
</table></div></div></div>
<div class="card"><div class="card-header">Phạm vi dữ liệu theo người dùng</div><div class="card-body p-0"><table class="table table-sm mb-0" data-grid="off">
    <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Vai trò</th><th>Chi nhánh làm việc</th><th>Phạm vi xem</th><th></th></tr></thead><tbody>
    @foreach (var u in users)
    {
        <tr><td>@u.Username</td><td>@u.FullName</td><td>@AppRoles.DisplayName(u.Role)</td><td>@u.Branch?.Name</td><td>@(u.AllBranches ? "Mọi chi nhánh" : "Chỉ chi nhánh làm việc")</td>
            <td>@if (User.IsAdmin()) { <a asp-controller="Users" asp-action="Edit" asp-route-id="@u.Id">Sửa</a> }</td></tr>
    }
</tbody></table></div></div>

@{
    var ovs = (List<PermissionOverride>)ViewBag.Overrides;
    var titles = Menu.Groups.SelectMany(g => g.Items.Select(i => (i.Key, Title: g.Title + " › " + i.Title))).ToDictionary(x => x.Key, x => x.Title);
}
<div class="card mt-3"><div class="card-header">Ghi đè quyền theo vai trò / người dùng</div><div class="card-body">
    <p class="small text-muted mb-2">Thu hẹp quyền gốc của vai trò trên từng chức năng: <b>Không truy cập</b> (ẩn khỏi menu, chặn mở) hoặc <b>Chỉ xem</b> (mở được nhưng không thêm, sửa, xóa, duyệt). Ghi đè theo người dùng được ưu tiên hơn theo vai trò. Không áp dụng cho Quản trị hệ thống.</p>
    @if (User.IsAdmin())
    {
        <form asp-action="AddOverride" method="post" class="row g-2 mb-3">
            <div class="col-md-3"><select name="target" class="form-select form-select-sm" required><option value="">-- Vai trò / người dùng --</option>
                <optgroup label="Vai trò">@foreach (var r in roles.Where(r => r != AppRoles.Admin)) { <option value="role:@r">@AppRoles.DisplayName(r)</option> }</optgroup>
                <optgroup label="Người dùng">@foreach (var u in users.Where(u => u.Role != AppRoles.Admin)) { <option value="user:@u.Id">@u.Username – @u.FullName</option> }</optgroup></select></div>
            <div class="col-md-4"><select name="menuKey" class="form-select form-select-sm" required><option value="">-- Chức năng --</option>
                @foreach (var g in Menu.Groups) { <optgroup label="@g.Title">@foreach (var i in g.Items) { <option value="@i.Key">@i.Title</option> }</optgroup> }</select></div>
            <div class="col-md-2"><select name="mode" asp-items="Html.GetEnumSelectList<PermissionMode>()" class="form-select form-select-sm"></select></div>
            <div class="col-md-2"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
            <div class="col-md-1"><button class="btn btn-sm btn-primary w-100">Thêm</button></div>
        </form>
    }
    <table class="table table-sm mb-0" data-grid="off"><thead><tr><th>Áp dụng cho</th><th>Chức năng</th><th>Mức</th><th>Ghi chú</th><th></th></tr></thead><tbody>
    @foreach (var o in ovs)
    {
        <tr><td>@(o.User != null ? $"{o.User.Username} – {o.User.FullName}" : "Vai trò " + AppRoles.DisplayName(o.Role ?? ""))</td><td>@(titles.TryGetValue(o.MenuKey, out var t) ? t : o.MenuKey)</td>
            <td><span class="badge @(o.Mode == PermissionMode.Deny ? "bg-danger" : "bg-warning text-dark")">@o.Mode.GetDisplayName()</span></td><td class="small">@o.Note</td>
            <td>@if (User.IsAdmin()) { <form asp-action="DeleteOverride" asp-route-id="@o.Id" method="post"><button class="btn btn-sm btn-link py-0">Xóa</button></form> }</td></tr>
    }
    @if (!ovs.Any()) { <tr><td colspan="5" class="text-center text-muted py-2">Chưa có ghi đè – quyền theo vai trò như bảng trên.</td></tr> }
    </tbody></table>
</div></div>
