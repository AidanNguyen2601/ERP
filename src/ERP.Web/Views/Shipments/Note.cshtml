@model InventoryDoc
@{ Layout = null; var cfg = (ErpSettings)ViewBag.Company; var s = ViewBag.Shipment as Shipment; var so = ViewBag.Order as SalesOrder; }
<!doctype html>
<html lang="vi"><head><meta charset="utf-8" /><title>Phiếu giao hàng @Model.Number</title>
<style>body{font-family:"Times New Roman",serif;font-size:14px;max-width:820px;margin:20px auto;color:#000}h2{text-align:center;margin:12px 0 2px}table{width:100%;border-collapse:collapse;margin-top:10px}th,td{border:1px solid #444;padding:5px 7px}th{background:#eee}td.n{text-align:right}.s{display:flex;justify-content:space-around;margin-top:30px;text-align:center}@@media print{button{display:none}}</style></head>
<body>
<div><b>@cfg.CompanyName</b><br />@cfg.CompanyAddress</div>
<h2>PHIẾU GIAO HÀNG</h2><div style="text-align:center">Số: @Model.Number · Ngày @Model.Date.ToDate() @(so != null ? "· Theo đơn bán " + so.Number : "")</div>
<p>Khách hàng: <b>@Model.Partner?.Name</b><br />Địa chỉ giao: @(s?.Address ?? Model.Partner?.Address) · Người nhận: @(s?.Receiver ?? Model.Partner?.ContactPerson) · ĐT: @Model.Partner?.Phone<br />
Xuất từ kho: @Model.Warehouse?.Name @(s != null ? $"· Vận chuyển: {s.Carrier} {s.VehicleNo} {s.Driver} {s.TrackingNo}" : "")</p>
<table><thead><tr><th>STT</th><th>Hàng hóa</th><th>ĐVT</th><th>Số lượng giao</th>@if (so != null) { <th>Đã giao lũy kế</th><th>Còn phải giao</th> }</tr></thead><tbody>
@{ var i = 0; }
@foreach (var l in Model.Lines)
{
    var sl = so?.Lines.FirstOrDefault(x => x.ItemId == l.ItemId);
    <tr><td>@(++i)</td><td>@l.Item?.Code – @l.Item?.Name</td><td>@l.Item?.Unit</td><td class="n">@l.Quantity.ToQty()</td>@if (so != null) { <td class="n">@(sl?.DeliveredQty.ToQty())</td><td class="n">@(sl == null ? "" : (sl.Quantity - sl.DeliveredQty).ToQty())</td> }</tr>
}</tbody></table>
<div class="s"><div><b>Người lập phiếu</b></div><div><b>Thủ kho</b></div><div><b>Người giao hàng</b></div><div><b>Người nhận hàng</b><br /><i>(Ký, ghi rõ họ tên)</i></div></div>
<p><button onclick="window.print()">In phiếu giao hàng</button></p>
</body></html>
