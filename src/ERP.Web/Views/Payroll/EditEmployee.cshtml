@model Employee
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm nhân viên" : $"Sửa nhân viên {Model.Code}";
    var dups = ViewBag.Duplicates as List<string>;
}
@if (dups?.Any() == true)
{
    <div class="alert alert-warning small"><b>Cảnh báo trùng dữ liệu:</b><ul class="mb-1">@foreach (var d in dups) { <li>@d</li> }</ul>
        @if (DuplicateService.CanOverride(User)) { <span>Tích "Vẫn lưu dù trùng" bên dưới nếu đã kiểm tra.</span> } else { <span>Chỉ Kế toán trưởng / Ban Giám đốc / Quản trị được xác nhận lưu.</span> }</div>
}
<div class="card" style="max-width:1000px"><div class="card-body">
<form asp-action="EditEmployee" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Mã nhân viên</label><input asp-for="Code" class="form-control" placeholder="Để trống: tự sinh" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-5"><label class="form-label">Họ tên</label><input asp-for="FullName" class="form-control" required /><span asp-validation-for="FullName" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Chi nhánh</label><select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select"><option value="">-- Chung --</option></select></div>
        <div class="col-md-4"><label class="form-label">Phòng ban</label><input asp-for="Department" class="form-control" list="depts" /><datalist id="depts">@foreach (string d in ViewBag.Depts) { <option value="@d"></option> }</datalist></div>
        <div class="col-md-4"><label class="form-label">Chức danh</label><input asp-for="Position" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Ngày vào làm</label><input asp-for="StartDate" type="date" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Lương cơ bản (tháng)</label><input asp-for="BaseSalary" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Phụ cấp chịu thuế</label><input asp-for="Allowance" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Phụ cấp không chịu thuế</label><input asp-for="NonTaxAllowance" type="number" step="1000" class="form-control" /><div class="form-text">Ăn trưa, điện thoại... theo quy định</div></div>
        <div class="col-md-3"><label class="form-label">Lương đóng bảo hiểm</label><input asp-for="InsuranceSalary" type="number" step="1000" class="form-control" /><div class="form-text">0 = bằng lương cơ bản</div></div>
        <div class="col-md-3"><label class="form-label">Số người phụ thuộc</label><input asp-for="Dependents" type="number" min="0" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">MST cá nhân</label><input asp-for="PersonalTaxCode" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Số CCCD</label><input asp-for="IdNumber" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">TK chi phí lương</label><select asp-for="ExpenseAccount" class="form-select">@foreach (Account a in ViewBag.ExpenseAccounts) { <option value="@a.Code">@a.Code – @a.Name</option> }</select><span asp-validation-for="ExpenseAccount" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Số tài khoản</label><input asp-for="BankAccountNo" class="form-control" /></div>
        <div class="col-md-5"><label class="form-label">Ngân hàng</label><input asp-for="BankName" class="form-control" /></div>
        <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Đang làm việc</label></div></div>
        <div class="col-12"><hr class="my-1" /><div class="fw-semibold small text-muted">Hồ sơ cá nhân</div></div>
        <div class="col-md-3"><label class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Giới tính</label><select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"><option value="">--</option></select></div>
        <div class="col-md-3"><label class="form-label">Điện thoại</label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <div class="col-md-8"><label class="form-label">Địa chỉ thường trú</label><input asp-for="Address" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Trình độ học vấn</label><input asp-for="Education" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Tình trạng hôn nhân</label><input asp-for="MaritalStatus" class="form-control" /></div>
        <div class="col-md-5"><label class="form-label">Người liên hệ khẩn cấp</label><input asp-for="EmergencyContact" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Số sổ BHXH</label><input asp-for="InsuranceBookNo" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Phép năm (ngày)</label><input asp-for="AnnualLeaveDays" type="number" step="0.5" min="0" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Ca làm việc mặc định</label><select asp-for="DefaultShiftId" asp-items="ViewBag.Shifts" class="form-select"><option value="">-- Theo giờ quẹt --</option></select></div>
        <div class="col-md-3"><label class="form-label">Ngày nghỉ việc</label><input asp-for="ResignDate" type="date" class="form-control" /></div>
        @if (dups?.Any() == true && DuplicateService.CanOverride(User))
        {
            <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="confirmDuplicate" value="true" id="cd" /><label class="form-check-label text-danger" for="cd">Vẫn lưu dù trùng</label></div></div>
        }
    </div>
    <div class="mt-4"><button class="btn btn-primary">Lưu</button> <a asp-action="Employees" class="btn btn-light">Hủy</a></div>
</form>
</div></div>
