@model InventoryDocForm
@{
    ViewData["Title"] = (Model.Id == 0 ? "Lập phiếu " : "Sửa phiếu ") + Model.Type.GetDisplayName().ToLower();
    var opts = (LineEditorOptions)ViewBag.LineOptions;
}
<partial name="_Nav" />
<form asp-action="Save" method="post">
<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Type" />
<div class="card mb-3"><div class="card-body">
    <div asp-validation-summary="All" class="alert alert-danger py-2 empty-hide"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="WarehouseId" class="form-label">@(Model.Type == InvDocType.Transfer ? "Kho xuất" : "Kho")</label><select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.Whs"><option value="">-- Chọn --</option></select></div>
        @if (Model.Type == InvDocType.Transfer)
        {
            <div class="col-md-3"><label asp-for="ToWarehouseId" class="form-label"></label><select asp-for="ToWarehouseId" class="form-select" asp-items="ViewBag.ToWhs"><option value="">-- Chọn --</option></select></div>
        }
        @if (Model.Type is InvDocType.Receipt or InvDocType.Issue)
        {
            <div class="col-md-3"><label asp-for="CounterAccountId" class="form-label"></label><select asp-for="CounterAccountId" class="form-select" asp-items="ViewBag.Counter"><option value="">-- Chọn TK --</option></select>
                <div class="form-text">@(Model.Type == InvDocType.Receipt ? "VD: 3381 hàng thừa, 711 được tặng, 4111 góp vốn" : "VD: 6428 dùng cho quản lý, 641 khuyến mại, 811 hủy hàng")</div></div>
            <div class="col-md-3"><label asp-for="PartnerId" class="form-label"></label><select asp-for="PartnerId" class="form-select" asp-items="ViewBag.Partners"><option value="">-- Không --</option></select></div>
        }
        <div class="col-md-12"><label asp-for="Reason" class="form-label"></label><input asp-for="Reason" class="form-control" /></div>
    </div>
</div></div>
<div class="card mb-3"><div class="card-body">
    <partial name="_ItemLines" model="opts" />
    @if (Model.Type == InvDocType.Adjustment) { <div class="small text-muted">Nhập số lượng thực tế kiểm đếm. Khi ghi sổ, hệ thống so với tồn sổ sách: thừa → Nợ 15x / Có 3381; thiếu → Nợ 1381 / Có 15x (theo giá vốn bình quân).</div> }
    @if (Model.Type == InvDocType.Issue) { <div class="small text-muted">Giá xuất = giá vốn bình quân gia quyền tại thời điểm ghi sổ.</div> }
</div></div>
<div class="d-flex gap-2">
    <button class="btn btn-light border" name="post" value="false">Lưu nháp</button>
    <button class="btn btn-primary" name="post" value="true">Lưu & ghi sổ</button>
    <a class="btn btn-light" asp-action="Docs">Hủy</a>
</div>
</form>
