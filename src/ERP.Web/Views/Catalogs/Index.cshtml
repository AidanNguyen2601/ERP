@model List<CatalogItem>
@{
    var type = (CatalogType)ViewBag.Type;
    ViewData["Title"] = "Danh mục " + type.GetDisplayName().ToLowerInvariant();
    var usage = (Dictionary<string, int>)ViewBag.Usage;
    var canEdit = (bool)ViewBag.CanEdit;
}
<div class="subnav">
    @foreach (CatalogType t in Enum.GetValues<CatalogType>())
    {
        <a class="@(t == type ? "active" : "")" asp-action="Index" asp-route-type="@t">@t.GetDisplayName()</a>
    }
</div>
<form class="toolbar" method="get">
    <input type="hidden" name="type" value="@type" />
    <div><label class="form-label small mb-0">Tìm</label><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Mã hoặc tên" /></div>
    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel"></i> Lọc</button>
    @if (canEdit) { <a class="btn btn-sm btn-primary ms-auto" asp-action="Create" asp-route-type="@type"><i class="bi bi-plus-lg"></i> Thêm @type.GetDisplayName().ToLowerInvariant()</a> }
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
    <thead><tr><th class="num">Thứ tự</th><th>Mã</th><th>Tên</th><th>Ghi chú</th><th class="num">Đang dùng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        var used = usage.GetValueOrDefault(c.Name);
        <tr class="@(c.IsActive ? "" : "text-muted")">
            <td class="num">@c.SortOrder</td><td><b>@c.Code</b></td><td>@c.Name</td><td class="small">@c.Note</td>
            <td class="num">@(used > 0 ? used.ToString() : "")</td>
            <td>@if (c.IsActive) { <span class="badge text-bg-success">Đang dùng</span> } else { <span class="badge text-bg-secondary">Ngưng</span> }</td>
            <td class="text-end text-nowrap">
                @if (canEdit)
                {
                    <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> Sửa</a>
                    @if (used == 0)
                    {
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Xóa &quot;@c.Name&quot;?"><button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button></form>
                    }
                }
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-3">Chưa có dữ liệu.</td></tr> }
    </tbody>
</table></div></div></div>
<p class="small text-muted mt-2">Các màn hình nhập liệu (hàng hóa, người dùng, tài sản...) chọn giá trị từ danh mục này. Đổi tên sẽ cập nhật theo cho dữ liệu đang dùng; giá trị đã dùng không xóa được – hãy chuyển sang <i>Ngưng</i>.</p>
