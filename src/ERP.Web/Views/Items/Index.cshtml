@model List<Item>
@inject AccountingService Acc
@{
    ViewData["Title"] = "Hàng hóa, vật tư"; var stock = (Dictionary<int, decimal>)ViewBag.Stock;
    var invAcc = new Dictionary<ItemType, string>();
    foreach (var t in new[] { ItemType.Material, ItemType.SemiFinished, ItemType.FinishedGood, ItemType.Merchandise }) invAcc[t] = (await Acc.RuleAccountAsync(PostingCatalog.InventoryKey(t))).Code;
}
<form class="toolbar" method="get">
    <div><label class="form-label small mb-0">Loại</label><select name="type" class="form-select form-select-sm"><option value="">-- Tất cả --</option>
        @foreach (ItemType t in Enum.GetValues<ItemType>()) { <option value="@t" selected="@(ViewBag.Type is ItemType x && x == t)">@t.GetDisplayName()</option> }</select></div>
    <div><label class="form-label small mb-0">Tìm</label><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" /></div>
    <button class="btn btn-sm btn-outline-primary">Lọc</button>
    @if ((bool)ViewBag.CanEdit) { <a class="btn btn-sm btn-primary ms-auto" asp-action="Create">+ Thêm hàng hóa</a> }
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
    <thead><tr><th>Mã</th><th>Tên hàng</th><th>ĐVT</th><th>Loại</th><th>TK kho</th><th class="num">Giá bán</th><th class="num">Giá vốn BQ</th><th class="num">VAT</th><th class="num">Tồn</th><th class="num">Tối thiểu</th><th></th></tr></thead>
    <tbody>
    @foreach (var i in Model)
    {
        var s = stock.GetValueOrDefault(i.Id);
        <tr class="@(i.IsActive ? "" : "text-muted")"><td><b>@i.Code</b></td><td>@i.Name</td><td>@i.Unit</td><td class="small">@i.Type.GetDisplayName()</td>
            <td class="small">@(i.IsStocked ? invAcc[i.Type] : "—")</td>
            <td class="num">@(i.SalePrice > 0 ? i.SalePrice.ToMoney() : "")</td><td class="num">@(i.IsStocked ? i.AvgCost.ToMoney() : "")</td><td class="num">@i.VatRate%</td>
            <td class="num @(i.MinStock > 0 && s < i.MinStock ? "bad fw-semibold" : "")">@(i.IsStocked ? s.ToQty() : "")</td><td class="num">@(i.MinStock > 0 ? i.MinStock.ToQty() : "")</td>
            <td class="text-end text-nowrap">@if (i.IsStocked) { <a class="btn btn-sm btn-light" asp-controller="Inventory" asp-action="StockCard" asp-route-itemId="@i.Id">Thẻ kho</a> }
                @if ((bool)ViewBag.CanEdit) { <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@i.Id">Sửa</a> }</td></tr>
    }
    </tbody>
</table></div></div></div>
<partial name="_PagerBag" />
