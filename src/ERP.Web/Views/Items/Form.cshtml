@model Item
@inject CatalogService Catalogs
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm hàng hóa" : $"Sửa {Model.Code}"; }
<div class="card" style="max-width:860px"><div class="card-body">
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-3"><label asp-for="Unit" class="form-label"></label>
            <select asp-for="Unit" asp-items="await Catalogs.SelectAsync(CatalogType.Unit, Model.Unit)" class="form-select"></select>
            <span asp-validation-for="Unit" class="text-danger small"></span>
            <div class="form-text"><a asp-controller="Catalogs" asp-action="Index" asp-route-type="Unit" target="_blank">Danh mục ĐVT</a></div></div>
        <div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ItemType>()"></select><span asp-validation-for="Type" class="text-danger small"></span>
            <div class="form-text">NVL → TK 152 · Thành phẩm → 155 · Hàng hóa → 1561 · Dịch vụ: không quản lý kho</div></div>
        <div class="col-md-3"><label asp-for="SalePrice" class="form-label"></label><input asp-for="SalePrice" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="VatRate" class="form-label"></label><select asp-for="VatRate" class="form-select">@foreach (var v in new[] { 0, 5, 8, 10 }) { <option value="@v">@v%</option> }</select></div>
        <div class="col-md-3"><label asp-for="MinStock" class="form-label"></label><input asp-for="MinStock" type="number" step="0.001" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="MaxStock" class="form-label"></label><input asp-for="MaxStock" type="number" step="0.001" class="form-control" /><span asp-validation-for="MaxStock" class="text-danger small"></span></div>
        <div class="col-md-5"><label asp-for="GroupId" class="form-label"></label><select asp-for="GroupId" asp-items="ViewBag.Groups" class="form-select"><option value="">-- Chưa phân nhóm --</option></select><div class="form-text"><a asp-action="Groups" target="_blank">Quản lý nhóm hàng</a></div></div>
        <div class="col-md-4"><label asp-for="Barcode" class="form-label"></label><input asp-for="Barcode" class="form-control" placeholder="Mã vạch / EAN (để trống: dùng mã hàng)" /><span asp-validation-for="Barcode" class="text-danger small"></span></div>
        <div class="col-12"><hr class="my-1" /><div class="small text-muted mb-1">Quản lý lô, serial, hạn dùng và phương pháp tính giá xuất kho</div></div>
        <div class="col-md-3"><label asp-for="TrackMode" class="form-label"></label><select asp-for="TrackMode" class="form-select" asp-items="Html.GetEnumSelectList<TrackMode>()"></select></div>
        <div class="col-md-3 pt-4"><div class="form-check"><input asp-for="TrackExpiry" class="form-check-input" /><label asp-for="TrackExpiry" class="form-check-label"></label></div><div class="form-text">Xuất theo FEFO (hết hạn trước xuất trước)</div></div>
        <div class="col-md-3"><label asp-for="ExpiryAlertDays" class="form-label"></label><input asp-for="ExpiryAlertDays" type="number" min="0" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="CostMethod" class="form-label"></label><select asp-for="CostMethod" class="form-select" asp-items="Html.GetEnumSelectList<CostMethod>()"></select><span asp-validation-for="CostMethod" class="text-danger small"></span></div>
        <div class="col-md-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        @if (Model.Id != 0) { <div class="col-12 small text-muted">Giá vốn bình quân hiện tại: @Model.AvgCost.ToMoney() (tự tính khi nhập kho – bình quân gia quyền di động).</div> }
    </div>
    <div class="mt-4"><button class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-light">Hủy</a></div>
</form>
</div></div>
@if (Model.Id != 0 && ViewBag.Uoms is List<UomConversion> uoms)
{
    <div class="card mt-3" style="max-width:860px"><div class="card-header">Quy đổi đơn vị tính (ĐVT cơ bản: @Model.Unit)</div><div class="card-body p-0"><table class="table table-sm mb-0" data-grid="off"><tbody>
        @foreach (var u in uoms) { <tr><td>1 @u.Unit</td><td>= @u.Factor.ToString("0.######") @Model.Unit</td><td class="text-end"><form asp-action="DeleteUom" asp-route-id="@u.Id" asp-route-itemId="@Model.Id" method="post"><button class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-x"></i></button></form></td></tr> }
        @if (!uoms.Any()) { <tr><td class="text-muted small">Chưa khai báo (VD: 1 Thùng = 12 Cái).</td></tr> }
    </tbody></table>
    <form asp-action="AddUom" method="post" class="row g-1 p-2"><input type="hidden" name="itemId" value="@Model.Id" /><div class="col-md-4"><input name="unit" class="form-control form-control-sm" placeholder="Đơn vị (VD: Thùng)" /></div><div class="col-md-4"><input name="factor" type="number" step="any" min="0" class="form-control form-control-sm" placeholder="Bằng bao nhiêu @Model.Unit" /></div><div class="col-md-2"><button class="btn btn-sm btn-primary">Thêm</button></div></form></div></div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
