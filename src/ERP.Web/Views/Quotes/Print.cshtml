@model SalesQuote
@{ Layout = null; var cfg = (ErpSettings)ViewBag.Company; }
<!doctype html>
<html lang="vi"><head><meta charset="utf-8" /><title>Báo giá @Model.Number</title>
<style>body{font-family:"Times New Roman",serif;font-size:14px;max-width:820px;margin:20px auto;color:#000}h2{text-align:center;margin:12px 0 2px}table{width:100%;border-collapse:collapse;margin-top:10px}th,td{border:1px solid #444;padding:5px 7px}th{background:#eee}td.n{text-align:right}.s{display:flex;justify-content:space-between;margin-top:30px;text-align:center}@@media print{button{display:none}}</style></head>
<body>
<div><b>@cfg.CompanyName</b><br />MST: @cfg.CompanyTaxCode<br />@cfg.CompanyAddress</div>
<h2>BÁO GIÁ</h2><div style="text-align:center">Số: @Model.Number · Ngày @Model.Date.ToDate() · Hiệu lực đến @Model.ValidUntil.ToDate()</div>
<p>Kính gửi: <b>@Model.Customer?.Name</b>@(Model.Customer?.Address != null ? " – " + Model.Customer.Address : "")<br />Chúng tôi xin gửi báo giá như sau:</p>
<table><thead><tr><th>STT</th><th>Hàng hóa, dịch vụ</th><th>ĐVT</th><th>SL</th><th>Đơn giá</th><th>CK %</th><th>Thành tiền</th></tr></thead><tbody>
@{ var i = 0; }
@foreach (var l in Model.Lines) { <tr><td>@(++i)</td><td>@l.Item?.Name</td><td>@l.Item?.Unit</td><td class="n">@l.Quantity.ToQty()</td><td class="n">@l.UnitPrice.ToMoney()</td><td class="n">@(l.DiscountPct == 0 ? "" : l.DiscountPct.ToString("0.#"))</td><td class="n">@l.Amount.ToMoney()</td></tr> }
<tr><td colspan="6" class="n">Cộng tiền hàng</td><td class="n">@Model.Subtotal.ToMoney()</td></tr>
<tr><td colspan="6" class="n">Thuế GTGT</td><td class="n">@Model.VatAmount.ToMoney()</td></tr>
<tr><td colspan="6" class="n"><b>Tổng cộng</b></td><td class="n"><b>@Model.Total.ToMoney()</b></td></tr></tbody></table>
<p>Bằng chữ: <i>@VietnameseNumber.ToWords(Model.Total)</i></p>
@if (!string.IsNullOrEmpty(Model.Note)) { <p>Điều kiện: @Model.Note</p> }
<div class="s"><div><b>Khách hàng</b><br /><i>(Xác nhận)</i></div><div><b>Nhân viên kinh doanh</b><br />@Model.Salesperson?.FullName</div></div>
<p><button onclick="window.print()">In báo giá</button></p>
</body></html>
