@model SalesQuote
@{
    ViewData["Title"] = Model.Id == 0 ? "Lập báo giá & phương án kinh doanh" : $"Sửa báo giá {Model.Number}"; var items = (List<Item>)ViewBag.Items; var lines = Model.Lines.ToList(); var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<form asp-action="Save" method="post">
<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="SalespersonId" />
<div class="card mb-3"><div class="card-body">
    <div asp-validation-summary="All" class="alert alert-danger py-2 empty-hide"></div>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label">Khách hàng</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"><option value="">-- Chọn --</option></select></div>
        <div class="col-md-2"><label class="form-label">Ngày báo giá</label><input asp-for="Date" type="date" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Hiệu lực đến</label><input asp-for="ValidUntil" type="date" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Kho xuất dự kiến</label><select asp-for="WarehouseId" asp-items="ViewBag.Whs" class="form-select"><option value="">--</option></select></div>
        <div class="col-md-3"><label class="form-label">Chi phí khác (vận chuyển, lắp đặt, hoa hồng...)</label><input asp-for="OtherCost" type="number" step="1000" min="0" class="form-control" id="otherCost" /></div>
        <div class="col-md-9"><label class="form-label">Ghi chú / điều kiện thương mại</label><input asp-for="Note" class="form-control" /></div>
    </div>
</div></div>
<div class="card mb-3"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0" id="lines" data-grid="off">
    <thead><tr><th style="min-width:250px">Hàng hóa</th><th style="width:100px">SL</th><th style="width:130px">Đơn giá</th><th style="width:90px">CK %</th><th style="width:130px">Giá vốn dự toán</th><th class="num" style="width:130px">Thành tiền</th><th class="num" style="width:90px">LN %</th><th></th></tr></thead>
    <tbody>
    @for (var k = 0; k < lines.Count; k++)
    {
        var l = lines[k];
        <tr><td><select name="lines[@k].ItemId" class="form-select form-select-sm item"><option value="0">-- Chọn --</option>@foreach (var i in items) { <option value="@i.Id" selected="@(l.ItemId == i.Id)">@i.Code – @i.Name</option> }</select></td>
            <td><input name="lines[@k].Quantity" type="number" step="any" min="0" value="@l.Quantity.ToString("0.###", inv)" class="form-control form-control-sm calc qty" /></td>
            <td><input name="lines[@k].UnitPrice" type="number" step="any" min="0" value="@l.UnitPrice.ToString("0.##", inv)" class="form-control form-control-sm calc price" /></td>
            <td><input name="lines[@k].DiscountPct" type="number" step="0.1" min="0" max="100" value="@l.DiscountPct.ToString("0.##", inv)" class="form-control form-control-sm calc disc" /></td>
            <td><input name="lines[@k].UnitCost" type="number" step="any" min="0" value="@l.UnitCost.ToString("0.##", inv)" class="form-control form-control-sm calc cost" /></td>
            <td class="num amount">0</td><td class="num margin">0</td>
            <td><button type="button" class="btn btn-sm btn-link text-danger" onclick="this.closest('tr').remove();calc()"><i class="bi bi-x"></i></button></td></tr>
    }
    </tbody>
    <tfoot><tr><td colspan="8"><button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">+ Thêm dòng</button>
        <span class="float-end fw-semibold">Doanh thu <span id="sumRev">0</span> · Giá vốn <span id="sumCost">0</span> · Chi phí khác <span id="sumOther">0</span> · Lợi nhuận <span id="sumProfit">0</span> (<span id="sumPct">0</span>%)</span></td></tr></tfoot>
</table></div></div></div>
<div class="d-flex gap-2 align-items-center">
    <div class="form-check me-3"><input type="checkbox" class="form-check-input" name="useList" value="true" id="ul" /><label class="form-check-label small" for="ul">Lấy lại giá / chiết khấu từ bảng giá khi lưu</label></div>
    <button class="btn btn-light border" name="submit" value="false">Lưu nháp</button><button class="btn btn-primary" name="submit" value="true">Lưu & gửi duyệt</button><a class="btn btn-light" asp-action="Index">Hủy</a>
</div>
</form>
@section Scripts {
<script>
const fmt = n => Math.round(n).toLocaleString('vi-VN');
function calc() {
    let rev = 0, cost = 0;
    document.querySelectorAll('#lines tbody tr').forEach(tr => {
        const q = +tr.querySelector('.qty').value || 0, p = +tr.querySelector('.price').value || 0, d = +tr.querySelector('.disc').value || 0, c = +tr.querySelector('.cost').value || 0;
        const a = Math.round(q * p * (100 - d) / 100), cc = q * c; rev += a; cost += cc;
        tr.querySelector('.amount').textContent = fmt(a); tr.querySelector('.margin').textContent = a ? ((a - cc) * 100 / a).toFixed(1) : '0';
    });
    const other = +document.getElementById('otherCost').value || 0, profit = rev - cost - other;
    sumRev.textContent = fmt(rev); sumCost.textContent = fmt(cost); sumOther.textContent = fmt(other); sumProfit.textContent = fmt(profit); sumPct.textContent = rev ? (profit * 100 / rev).toFixed(1) : '0';
}
function renum() { document.querySelectorAll('#lines tbody tr').forEach((tr, k) => tr.querySelectorAll('[name]').forEach(el => el.name = el.name.replace(/lines\[\d+\]/, 'lines[' + k + ']'))); }
function addRow() { const tb = document.querySelector('#lines tbody'); const tr = tb.querySelector('tr').cloneNode(true); tr.querySelectorAll('input').forEach(i => i.value = i.classList.contains('qty') ? '1' : '0'); tr.querySelector('select').selectedIndex = 0; tb.appendChild(tr); renum(); bind(tr); calc(); }
function bind(tr) {
    tr.querySelectorAll('.calc').forEach(i => i.addEventListener('input', calc));
    tr.querySelector('.item').addEventListener('change', async e => {
        if (!e.target.value || e.target.value === '0') return;
        const r = await (await fetch(`@Url.Action("Lookup")?itemId=${e.target.value}&partnerId=${document.getElementById('CustomerId').value || ''}&qty=${tr.querySelector('.qty').value || 1}`)).json();
        tr.querySelector('.price').value = r.price; tr.querySelector('.disc').value = r.discountPct; tr.querySelector('.cost').value = r.cost; tr.querySelector('.price').title = r.source; calc();
    });
}
document.querySelectorAll('#lines tbody tr').forEach(bind); document.getElementById('otherCost').addEventListener('input', calc); calc();
document.querySelector('form').addEventListener('submit', renum);
</script>
}
