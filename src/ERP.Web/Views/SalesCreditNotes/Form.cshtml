@model CreditNoteForm
@using ERP.Web.Services
@{
    var inv = (Invoice)ViewBag.Invoice;
    var credited = (Dictionary<int, CreditedLine>)ViewBag.Credited;
    var isReturn = Model.Kind == CreditNoteKind.Return;
    ViewData["Title"] = (isReturn ? "Hàng bán bị trả lại" : "Giảm giá hàng bán") + $" – HĐ {inv.Series} {inv.InvoiceNo}";
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="InvoiceId" /><input type="hidden" asp-for="Kind" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 empty-hide"></div>
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-12 small text-muted">Điều chỉnh giảm cho hóa đơn <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id">@inv.Series @inv.InvoiceNo</a> ngày @inv.Date.ToDate() – @inv.Partner?.Name ·
            tổng @inv.Total.ToMoney() · còn nợ @inv.Outstanding.ToMoney()</div>
        <div class="col-md-3"><label asp-for="Date" class="form-label">Ngày điều chỉnh</label><input asp-for="Date" type="date" class="form-control" /></div>
        @if (isReturn)
        {
            <div class="col-md-4"><label asp-for="WarehouseId" class="form-label">Kho nhận hàng trả lại</label><select asp-for="WarehouseId" asp-items="ViewBag.Whs" class="form-select"><option value="">-- Chọn --</option></select></div>
        }
        <div class="col-md-5"><label asp-for="Reason" class="form-label">Lý do</label><input asp-for="Reason" class="form-control" placeholder="@(isReturn ? "VD: Hàng lỗi bản lề, khách trả lại" : "VD: Giảm giá do giao chậm")" /></div>
    </div></div></div>
    <div class="card mb-3"><div class="card-header">@(isReturn ? "Chọn hàng trả lại (nhập số lượng)" : "Chọn dòng giảm giá (nhập số tiền giảm chưa thuế)")</div><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-sm align-middle mb-0" data-grid="off">
            <thead><tr><th>#</th><th>Hàng hóa / dịch vụ</th><th class="num">Số lượng HĐ</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th><th class="num">VAT</th>
                <th class="num">Còn điều chỉnh được</th><th style="width:170px">@(isReturn ? "Số lượng trả lại" : "Số tiền giảm")</th></tr></thead>
            <tbody>
            @{ var k = 0; }
            @foreach (var l in inv.Lines)
            {
                var c = credited.GetValueOrDefault(l.Id) ?? new CreditedLine(0, 0, 0);
                var remQty = l.Quantity - c.Qty; var remAmt = l.Amount - c.Amount;
                var stocked = l.Item?.IsStocked == true;
                var disabled = remAmt <= 0 || (isReturn && (!stocked || remQty <= 0));
                var posted = Model.Lines.FirstOrDefault(x => x.InvoiceLineId == l.Id);
                <tr class="@(disabled ? "text-muted" : "")">
                    <td>@(k + 1)</td><td>@l.Description @if (isReturn && !stocked) { <span class="small">(dịch vụ – dùng "Giảm giá")</span> }</td>
                    <td class="num">@l.Quantity.ToQty()</td><td class="num">@l.UnitPrice.ToMoney()</td><td class="num">@l.Amount.ToMoney()</td><td class="num">@l.VatRate%</td>
                    <td class="num">@(isReturn ? remQty.ToQty() + " " + l.Unit : remAmt.ToMoney())@if (c.Amount > 0) { <div class="small text-muted">đã điều chỉnh @c.Amount.ToMoney()</div> }</td>
                    <td>
                        <input type="hidden" name="Lines[@k].InvoiceLineId" value="@l.Id" />
                        @if (isReturn) { <input name="Lines[@k].Quantity" type="number" step="0.001" min="0" max="@remQty.Raw()" class="form-control form-control-sm text-end" disabled="@disabled" value="@(posted?.Quantity > 0 ? posted.Quantity.Raw() : "")" /> }
                        else { <input name="Lines[@k].Amount" type="number" step="1" min="0" max="@remAmt.Raw()" class="form-control form-control-sm text-end" disabled="@disabled" value="@(posted?.Amount > 0 ? posted.Amount.Raw() : "")" /> }
                    </td>
                </tr>
                k++;
            }
            </tbody>
        </table></div></div></div>
    <div class="alert alert-info py-2 small">
        @if (isReturn) { <span>Hàng trả lại được <b>nhập kho theo giá vốn lúc bán</b> (Nợ 15x / Có 632); doanh thu giảm trừ ghi <b>Nợ 5212</b>, thuế đầu ra điều chỉnh giảm, <b>Có 131</b> và cấn trừ vào hóa đơn này.</span> }
        else { <span>Giảm giá ghi <b>Nợ 5213</b>, thuế đầu ra điều chỉnh giảm, <b>Có 131</b> và cấn trừ vào hóa đơn này; không nhập kho.</span> }
        <a asp-controller="PostingRules" asp-action="Index" asp-route-module="Hóa đơn" target="_blank">Cấu hình bút toán</a>
    </div>
    <button class="btn btn-primary" data-confirm-click="Lập điều chỉnh giảm? Bút toán, tồn kho và công nợ được ghi ngay."><i class="bi bi-check2"></i> Lập điều chỉnh giảm</button>
    <a class="btn btn-light" asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id">Hủy</a>
</form>
@section Scripts {
<script>document.querySelectorAll('[data-confirm-click]').forEach(b => b.addEventListener('click', e => { if (!confirm(b.getAttribute('data-confirm-click'))) e.preventDefault(); }));</script>
}
