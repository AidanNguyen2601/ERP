@inject Microsoft.Extensions.Options.IOptions<ErpSettings> Cfg
@model CashVoucher
@{ ViewData["Title"] = $"{Model.Type.GetDisplayName()} {Model.Number}"; }
<div class="actions mb-3">
    <a class="btn btn-sm btn-light border" asp-action="Index">← Danh sách</a>
    <button class="btn btn-sm btn-light border" onclick="window.print()">In phiếu</button>
    @if (Model.JournalEntryId.HasValue) { <a class="btn btn-sm btn-light border" asp-controller="Journals" asp-action="Details" asp-route-id="@Model.JournalEntryId">Xem bút toán</a> }
    @if (User.CanAccounting() && Model.Status == DocStatus.Posted)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-flex gap-1" data-confirm="Hủy phiếu và đảo bút toán?">
            <input name="reason" class="form-control form-control-sm" placeholder="Lý do hủy" required /><button class="btn btn-sm btn-outline-danger text-nowrap">Hủy phiếu</button></form>
    }
</div>
<div class="print-paper">
    <div class="d-flex justify-content-between small"><div><b>@Cfg.Value.CompanyName</b><br />@Cfg.Value.CompanyAddress</div><div class="text-end">Mẫu số @(Model.Type == CashVoucherType.Payment ? "02-TT" : "01-TT")<br />(Ban hành theo TT 200/2014/TT-BTC)</div></div>
    <h3 class="mt-3 mb-0">@(Model.Type == CashVoucherType.Transfer ? "ỦY NHIỆM CHI / CHUYỂN TIỀN" : Model.Type == CashVoucherType.Receipt ? "PHIẾU THU" : "PHIẾU CHI")</h3>
    <div class="text-center small mb-3">Ngày @Model.Date.Day tháng @Model.Date.Month năm @Model.Date.Year · Số: <b>@Model.Number</b> @if (Model.Status == DocStatus.Cancelled) { <span class="badge bg-dark">ĐÃ HỦY</span> }</div>
    <table class="table table-borderless table-sm">
        <tr><td style="width:220px">Họ tên người @(Model.Type == CashVoucherType.Receipt ? "nộp" : "nhận") tiền:</td><td>@Model.PayerPayee</td></tr>
        <tr><td>Đơn vị:</td><td>@Model.Partner?.Name</td></tr>
        <tr><td>Lý do:</td><td>@Model.Description</td></tr>
        <tr><td>Quỹ / tài khoản:</td><td>@Model.CashAccount?.Name (TK @Model.CashAccount?.Account?.Code)@(Model.ToCashAccount != null ? " → " + Model.ToCashAccount.Name : "")</td></tr>
        <tr><td>Số tiền:</td><td class="fw-bold fs-5">@Model.Amount.ToMoney() đồng</td></tr>
        <tr><td>Bằng chữ:</td><td><i>@VietnameseNumber.ToWords(Model.Amount)</i></td></tr>
        @if (Model.CounterAccount != null) { <tr><td>TK đối ứng:</td><td>@Model.CounterAccount.Code – @Model.CounterAccount.Name</td></tr> }
    </table>
    @if (Model.Allocations.Any())
    {
        <div class="small fw-semibold">Cấn trừ hóa đơn:</div>
        <table class="table table-sm small"><thead><tr><th>Hóa đơn</th><th>Ngày</th><th class="num">Số tiền cấn trừ</th></tr></thead><tbody>
        @foreach (var a in Model.Allocations) { <tr><td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@a.InvoiceId">@a.Invoice?.Series @a.Invoice?.InvoiceNo</a></td><td>@a.Invoice?.Date.ToDate()</td><td class="num">@a.Amount.ToMoney()</td></tr> }
        @if (Model.Amount > Model.Allocations.Sum(a => a.Amount)) { <tr><td colspan="2"><i>Chưa cấn trừ (trả trước / ứng trước)</i></td><td class="num">@((Model.Amount - Model.Allocations.Sum(a => a.Amount)).ToMoney())</td></tr> }
        </tbody></table>
    }
    <div class="row text-center small mt-4"><div class="col">Giám đốc</div><div class="col">Kế toán trưởng</div><div class="col">Người lập phiếu<br /><br /><br />@Model.CreatedBy?.FullName</div><div class="col">Thủ quỹ</div><div class="col">Người @(Model.Type == CashVoucherType.Receipt ? "nộp" : "nhận") tiền</div></div>
</div>
