@model Contract
@{ ViewData["Title"] = Model.Id == 0 ? (Model.Type == ContractType.Sale ? "Thêm hợp đồng bán" : "Thêm hợp đồng mua") : $"Sửa hợp đồng {Model.Number}"; }
<div class="card" style="max-width:960px"><div class="card-body">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Type" /><input type="hidden" asp-for="CreatedAt" />
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Số hợp đồng</label><input asp-for="Number" class="form-control" placeholder="Để trống: tự sinh" /><span asp-validation-for="Number" class="text-danger small"></span></div>
        <div class="col-md-6"><label class="form-label">@(Model.Type == ContractType.Sale ? "Khách hàng" : "Nhà cung cấp")</label><select asp-for="PartnerId" asp-items="ViewBag.Partners" class="form-select"><option value="">-- Chọn --</option></select><span asp-validation-for="PartnerId" class="text-danger small"></span></div>
        <div class="col-md-3"><label class="form-label">Trạng thái</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select"></select></div>
        <div class="col-12"><label class="form-label">Nội dung hợp đồng</label><input asp-for="Title" class="form-control" required /><span asp-validation-for="Title" class="text-danger small"></span></div>
        <div class="col-md-3"><label class="form-label">Ngày ký</label><input asp-for="SignDate" type="date" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Ngày hết hạn</label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger small"></span></div>
        <div class="col-md-3"><label class="form-label">Giá trị hợp đồng (VND)</label><input asp-for="Value" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Thời hạn thanh toán (ngày)</label><input asp-for="PaymentTermDays" type="number" min="0" class="form-control" /></div>
        <div class="col-12"><label class="form-label">Điều khoản thanh toán / tiến độ</label><textarea asp-for="PaymentTerms" rows="2" class="form-control" placeholder="VD: Tạm ứng 30% khi ký, 60% khi giao hàng, 10% sau nghiệm thu"></textarea></div>
        <div class="col-12"><label class="form-label">Ghi chú</label><input asp-for="Note" class="form-control" /></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-light">Hủy</a></div>
</form>
</div></div>
