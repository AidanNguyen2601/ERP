@model List<ServiceTicket>
@{ ViewData["Title"] = "Hỗ trợ khách hàng & bảo hành"; var can = (bool)ViewBag.CanEdit; var st = ViewBag.Status as TicketStatus?; var open = (bool)ViewBag.Open; var late = (bool)ViewBag.Late;
   var s = ((int Open, int Late, int Resolved, decimal OnTimePct, decimal AvgHours))ViewBag.Stats; }
<partial name="_CrmNav" model="@("tickets")" />
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="small text-muted">Đang mở</div><div class="fs-4 fw-bold">@s.Open</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="small text-muted">Quá hạn SLA</div><div class="fs-4 fw-bold @(s.Late > 0 ? "text-danger" : "")">@s.Late</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="small text-muted">Xử lý đúng hạn (90 ngày)</div><div class="fs-4 fw-bold">@s.OnTimePct%</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="small text-muted">Thời gian xử lý bình quân</div><div class="fs-4 fw-bold">@s.AvgHours.ToString("0.#") giờ</div></div></div></div>
</div>
<div class="toolbar">
    <a class="btn btn-sm @(open && st == null && !late ? "btn-secondary" : "btn-light border")" asp-action="Tickets">Đang mở</a>
    <a class="btn btn-sm @(late ? "btn-secondary" : "btn-light border")" asp-action="Tickets" asp-route-late="true">Quá hạn</a>
    @foreach (TicketStatus x in Enum.GetValues<TicketStatus>()) { <a class="btn btn-sm @(st == x ? "btn-secondary" : "btn-light border")" asp-action="Tickets" asp-route-status="@x">@x.GetDisplayName()</a> }
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body p-0"><table class="table table-sm mb-0">
        <thead><tr><th>Số</th><th>Khách hàng</th><th>Tiêu đề</th><th>Loại</th><th>Ưu tiên</th><th>Trạng thái</th><th>Phụ trách</th><th>Hạn SLA</th></tr></thead><tbody>
        @foreach (var t in Model)
        {
            <tr class="@(t.IsLate && t.IsOpen ? "table-danger" : "")"><td><a asp-action="Ticket" asp-route-id="@t.Id">@t.Number</a></td><td class="small">@t.Partner?.Name</td><td>@t.Subject @if (t.Item != null) { <div class="small text-muted">@t.Item.Code @t.SerialNo</div> }</td>
                <td class="small">@t.Category.GetDisplayName()</td><td><span class="badge @(t.Priority >= TicketPriority.High ? "bg-danger" : "bg-light text-dark border")">@t.Priority.GetDisplayName()</span></td>
                <td class="small">@t.Status.GetDisplayName()</td><td class="small">@t.Assignee?.FullName</td><td class="small text-nowrap">@t.DueAt.ToString("dd/MM HH:mm")</td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-3">Không có phiếu.</td></tr> }
    </tbody></table></div></div></div>
    @if (can)
    {
        <div class="col-lg-4"><div class="card"><div class="card-header">Tiếp nhận yêu cầu</div><div class="card-body"><form asp-action="CreateTicket" method="post" class="row g-2">
            <div class="col-12"><select name="PartnerId" asp-items="ViewBag.Customers" class="form-select form-select-sm" required><option value="">-- Khách hàng --</option></select></div>
            <div class="col-12"><input name="Subject" class="form-control form-control-sm" placeholder="Tiêu đề" required /></div>
            <div class="col-6"><select name="Category" asp-items="Html.GetEnumSelectList<TicketCategory>()" class="form-select form-select-sm"></select></div>
            <div class="col-6"><select name="Priority" class="form-select form-select-sm">@foreach (TicketPriority p in Enum.GetValues<TicketPriority>()) { <option value="@((int)p)" selected="@(p == TicketPriority.Normal)">@p.GetDisplayName() (@ServiceTicket.SlaHours(p) giờ)</option> }</select></div>
            <div class="col-8"><select name="ItemId" asp-items="ViewBag.Items" class="form-select form-select-sm"><option value="">-- Sản phẩm --</option></select></div>
            <div class="col-4"><input name="SerialNo" class="form-control form-control-sm" placeholder="Serial" /></div>
            <div class="col-6"><select name="AssigneeId" asp-items="ViewBag.Users" class="form-select form-select-sm"><option value="">-- Phụ trách --</option></select></div>
            <div class="col-6"><select name="Channel" class="form-select form-select-sm"><option>Điện thoại</option><option>Email</option><option>Zalo</option><option>Website</option><option>Trực tiếp</option></select></div>
            <div class="col-12"><textarea name="Description" rows="3" class="form-control form-control-sm" placeholder="Mô tả"></textarea></div>
            <div class="col-12"><button class="btn btn-sm btn-primary">Tiếp nhận</button></div></form>
            <div class="small text-muted mt-2">Loại “Bảo hành” tự tra hóa đơn bán sản phẩm cho khách và thời hạn bảo hành khai báo ở danh mục hàng.</div></div></div></div>
    }
</div>
