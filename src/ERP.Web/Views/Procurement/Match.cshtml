@model List<MatchLine>
@{ ViewData["Title"] = "Đối chiếu 3 bên: đơn mua – nhập kho – hóa đơn"; DateTime f = ViewBag.From, t = ViewBag.To; bool issues = ViewBag.Issues; }
<form class="toolbar" method="get">
    <div><label class="form-label small mb-0">Từ ngày</label><input type="date" name="from" value="@f.Iso()" class="form-control form-control-sm" /></div>
    <div><label class="form-label small mb-0">Đến ngày</label><input type="date" name="to" value="@t.Iso()" class="form-control form-control-sm" /></div>
    <div><label class="form-label small mb-0">Nhà cung cấp</label><select name="vendorId" asp-items="ViewBag.Vendors" class="form-select form-select-sm"><option value="">Tất cả</option></select></div>
    <div class="form-check pt-3"><input type="hidden" name="issues" value="false" /><input class="form-check-input" type="checkbox" name="issues" value="true" id="oi" checked="@issues" /><label class="form-check-label small" for="oi">Chỉ dòng chênh lệch</label></div>
    <button class="btn btn-sm btn-outline-primary">Đối chiếu</button>
    <a class="btn btn-sm btn-light ms-auto" asp-action="LandedCosts">Chi phí mua hàng</a>
</form>
<div class="alert alert-info small">So sánh từng dòng: <b>số lượng đặt</b> (đơn mua) ↔ <b>số lượng nhận</b> (phiếu nhập kho) ↔ <b>số lượng / đơn giá hóa đơn</b> (hóa đơn nhà cung cấp lập từ đơn). Cảnh báo nhận vượt đặt, hóa đơn vượt số nhận, lệch đơn giá, giao hàng quá hạn.</div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0" style="font-size:.85rem">
    <thead><tr><th>Đơn mua</th><th>Nhà cung cấp</th><th>Hàng hóa</th><th class="num">Đặt</th><th class="num">Nhận</th><th class="num">Hóa đơn</th><th class="num">Giá đơn mua</th><th class="num">Giá hóa đơn</th><th>Kết quả đối chiếu</th></tr></thead><tbody>
    @foreach (var m in Model)
    {
        <tr class="@(m.Issues.Any() ? "table-warning" : "")"><td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@m.Po.Id">@m.Po.Number</a></td><td class="small">@m.Po.Vendor?.Name</td><td>@m.Line.Item?.Code – @m.Line.Item?.Name</td>
            <td class="num">@m.Line.Quantity.ToQty()</td><td class="num">@m.Received.ToQty()</td><td class="num">@m.Invoiced.ToQty()</td><td class="num">@m.Line.UnitPrice.ToMoney()</td><td class="num">@(m.Invoiced == 0 ? "" : m.InvoicePrice.ToMoney())</td>
            <td class="small">@if (m.Issues.Any()) { <span class="text-danger">@string.Join("; ", m.Issues)</span> } else { <span class="text-success">Khớp</span> }</td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted py-3">@(issues ? "Không có chênh lệch trong kỳ." : "Không có đơn mua.")</td></tr> }
</tbody></table></div></div></div>
